{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticPrefixFixDepsChoreOthers"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": [
    "before 7am on monday"
  ],
  "dependencyDashboard": true,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 7am on the first day of the month"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchManagers": [
        "npm"
      ],
      "groupName": "npm: minor i patch"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "pinDigests": true
    },
    {
      "matchDepTypes": [
        "engines",
        "packageManager"
      ],
      "enabled": false
    }
  ]
}
