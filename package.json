{
  "name": "ciezko-na-sercu-web",
  "version": "1.66.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-data.mjs && astro build",
    "preview": "astro preview",
    "catalog": "node scripts/build-catalog.mjs",
    "import:tagger": "node scripts/import-tagger.mjs",
    "check": "node scripts/check-data.mjs",
    "queue": "node scripts/queue.mjs",
    "edytor": "node scripts/edytor-run.mjs",
    "test:e2e": "node scripts/e2e-tagi.mjs",
    "release": "semantic-release",
    "transcribe": "node scripts/transcribe.mjs",
    "episodes": "node scripts/fetch-episodes.mjs",
    "boundaries": "node scripts/snap-boundaries.mjs",
    "edytor:bez-nadzorcy": "node --watch scripts/edytor.mjs",
    "voiceprint:apply": "node scripts/import-voiceprint.mjs",
    "voiceprint": "node scripts/run-voiceprint.mjs",
    "voiceprint:status": "node scripts/voiceprint-status.mjs",
    "status": "node scripts/status-all.mjs",
    "identify": "node scripts/identify-tracks.mjs",
    "identify:apply": "node scripts/identify-tracks.mjs --write",
    "pipeline": "dot -Tsvg docs/pipeline.dot -o docs/pipeline.svg && dot -Tpng -Gdpi=200 docs/pipeline.dot -o docs/pipeline.png && dot -Tpdf docs/pipeline.dot -o docs/pipeline.pdf",
    "enrich": "node scripts/enrich-episode.mjs",
    "enrich:apply": "node scripts/enrich-episode.mjs --write",
    "llm:models": "node scripts/llm.mjs --models --all",
    "test:llm": "node --test scripts/lib/llm.test.mjs",
    "verify:migration": "node scripts/build-episode.mjs --from-legacy --check",
    "metadata": "node scripts/fetch-episode-metadata.mjs",
    "episode": "node scripts/build-episode.mjs",
    "spans": "${SPANS_PYTHON:-python3} scripts/speech_spans.py",
    "resolve": "${SPANS_PYTHON:-python3} scripts/resolve_tracks.py"
  },
  "dependencies": {
    "astro": "^7.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "node-shazam": "^1.2.7",
    "playwright": "^1.65.0",
    "semantic-release": "^25.0.9"
  }
}
