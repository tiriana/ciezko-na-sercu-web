---
import { ClientRouter } from 'astro:transitions';

import AudioBar from '../components/AudioBar.astro';
import { version } from '../../package.json';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
}

const { title, description, bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const buildId = process.env.GITHUB_SHA?.slice(0, 7) ?? 'local';
const buildDate = new Date().toISOString().replace(/\.\d{3}Z$/, 'Z');
const staging = process.env.STAGING === '1';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {staging && <meta name="robots" content="noindex" />}
    <meta name="version" content={version} />
    <meta name="build-id" content={buildId} />
    <meta name="build-date" content={buildDate} />
    <link rel="canonical" href={canonical} />
    <!-- Preload kroju latin: bez tego plik fontu jest odkrywany dopiero po CSS i tekst
         przez moment rysuje się fallbackiem. -->
    <link rel="preload" href="/fonts/inter-pl.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anton-pl.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <slot />
    <AudioBar />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
