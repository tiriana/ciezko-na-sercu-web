---
interface Props {
  current?: 'episodes' | 'about';
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark">Ciężko <span>na</span> sercu</span>
      <span class="brand__note">indeks audycji</span>
    </a>
    <nav class="site-nav" aria-label="Główna">
      <a href="/" aria-current={current === 'episodes' ? 'page' : undefined}>Odcinki</a>
      <a href="https://www.polskieradio.pl/trojka/audycje/ciezko-na-sercu,10644">Audycja</a>
      <a href="/o-projekcie/" aria-current={current === 'about' ? 'page' : undefined}>O projekcie</a>
    </nav>
    <button
      class="icon-btn"
      type="button"
      data-theme-toggle
      aria-label="Przełącz motyw"
      aria-pressed="false"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4" />
      </svg>
    </button>
  </div>
</header>
