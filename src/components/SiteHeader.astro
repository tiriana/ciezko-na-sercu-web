---
interface Props {
  current?: 'episodes' | 'tags' | 'about';
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark">Ciężko <span>na</span> sercu</span>
      <span class="brand__note">indeks audycji</span>
    </a>
    <nav class="site-nav" aria-label="Główna">
      <a href="/" aria-current={current === 'episodes' ? 'page' : undefined}>Odcinki</a>
      <a
        class="site-nav__external"
        href="https://www.polskieradio.pl/trojka/audycje/ciezko-na-sercu,10644"
        target="_blank"
        rel="noopener noreferrer"
      >
        Audycja
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M14 4h6v6M20 4l-8 8M10 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a href="/tagi/" aria-current={current === 'tags' ? 'page' : undefined}>Tagi</a>
      <a href="/o-projekcie/" aria-current={current === 'about' ? 'page' : undefined}>O projekcie</a>
    </nav>
  </div>
</header>
