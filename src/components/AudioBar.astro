---
/**
 * Pasek odtwarzacza żyje w layoucie i jest trwały między nawigacjami
 * (transition:persist), więc dźwięk nie przerywa się przy zmianie strony.
 * Źródło ustawia strona odcinka przez <script id="audio-data">.
 *
 * Układ jak w playerze Polskiego Radia: jedna linia, metadane po lewej, transport
 * i oś czasu w środku, głośność i zamknięcie po prawej. Kontrolki są własne, bo
 * natywne rysują białe tło na białym pasku i zależą od długości tytułu.
 */
---

<div class="audio-bar" transition:persist="player" data-audio-bar hidden>
  <div class="audio-bar__meta">
    <span class="audio-bar__badge">Trójka</span>
    <p class="audio-bar__title">
      <a data-audio-link href="/"><span data-audio-title></span></a>
      <span class="audio-bar__now" data-audio-now></span>
    </p>
  </div>

  <div class="audio-bar__transport">
    <button class="audio-bar__skip" type="button" data-skip="-10" aria-label="Cofnij 10 sekund">
      <span aria-hidden="true">−10</span>
    </button>

    <button class="audio-bar__toggle" type="button" data-play-toggle aria-label="Odtwórz">
      <svg class="audio-bar__icon audio-bar__icon--play" viewBox="0 0 42 42" aria-hidden="true">
        <circle cx="21" cy="21" r="21" fill="var(--accent)" />
        <path d="M17 14.5 28 21 17 27.5Z" fill="#fff" />
      </svg>
      <svg class="audio-bar__icon audio-bar__icon--pause" viewBox="0 0 42 42" aria-hidden="true">
        <circle cx="21" cy="21" r="21" fill="var(--accent)" />
        <rect x="15.5" y="14.5" width="3.5" height="13" fill="#fff" />
        <rect x="23" y="14.5" width="3.5" height="13" fill="#fff" />
      </svg>
    </button>

    <button class="audio-bar__skip" type="button" data-skip="10" aria-label="Przewiń 10 sekund">
      <span aria-hidden="true">+10</span>
    </button>
  </div>

  <div class="audio-bar__timeline">
    <span class="audio-bar__time" data-audio-current>0:00</span>
    <div
      class="audio-bar__progress"
      data-progress
      role="slider"
      tabindex="0"
      aria-label="Postęp odtwarzania"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div class="audio-bar__progress-fill" data-progress-fill></div>
      <div class="audio-bar__markers" data-markers aria-hidden="true"></div>
    </div>
    <span class="audio-bar__time" data-audio-total>0:00</span>
  </div>

  <div class="audio-bar__extras">
    <div class="audio-bar__jump">
      <button
        class="audio-bar__jump-toggle"
        type="button"
        data-jump-toggle
        aria-controls="audio-jump-menu"
        aria-expanded="false"
        aria-label="Skocz do…"
        title="Skocz do znacznika lub innej audycji"
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 4h10M3 8h6M3 12h10" stroke-linecap="round" />
          <path d="m10 6 3 2-3 2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>Skocz do</span>
      </button>
      <div class="audio-bar__jump-menu" id="audio-jump-menu" data-jump-menu hidden role="group" aria-label="Dodatkowe skoki">
        <section class="audio-bar__jump-group" aria-label="Znaczniki programu">
          <h2>Znaczniki</h2>
          <button type="button" data-jump-marker="-1" aria-label="Poprzedni znacznik" title="Poprzedni znacznik">
            <span aria-hidden="true">←</span><span>Poprzedni znacznik</span>
          </button>
          <button type="button" data-jump-marker="1" aria-label="Następny znacznik" title="Następny znacznik">
            <span aria-hidden="true">→</span><span>Następny znacznik</span>
          </button>
        </section>
        <section class="audio-bar__jump-group" aria-label="Audycje w katalogu">
          <h2>Audycje</h2>
          <button type="button" data-jump-episode="-1" aria-label="Poprzednia audycja" title="Poprzednia audycja">
            <span aria-hidden="true">←</span><span>Poprzednia audycja</span>
          </button>
          <button type="button" data-jump-episode="1" aria-label="Następna audycja" title="Następna audycja">
            <span aria-hidden="true">→</span><span>Następna audycja</span>
          </button>
        </section>
      </div>
    </div>
    <label class="audio-bar__volume">
      <span class="visually-hidden">Głośność</span>
      <svg viewBox="0 0 16 14" aria-hidden="true">
        <path d="M0 4h3l4-4v14L3 10H0Z" fill="currentColor" />
        <path d="M9 4a4 4 0 0 1 0 6" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <input type="range" min="0" max="1" step="0.01" value="1" data-volume aria-label="Głośność" />
    </label>
    <button class="audio-bar__close" type="button" data-audio-close aria-label="Zamknij odtwarzacz">
      <svg viewBox="0 0 12 12" aria-hidden="true">
        <path d="M1 1 11 11M11 1 1 11" fill="none" stroke="currentColor" stroke-width="1.6" />
      </svg>
    </button>
  </div>

  <audio
    id="episode-audio"
    preload="none"
    controlslist="nodownload noplaybackrate"
    disablepictureinpicture
    disableRemotePlayback
  ></audio>
</div>
