---
/**
 * Pasek odtwarzacza żyje w layoucie i jest trwały między nawigacjami
 * (transition:persist), więc dźwięk nie przerywa się przy zmianie strony.
 * Źródło ustawia strona odcinka przez <script id="audio-data">.
 */
const note =
  'Nagranie pochodzi z publicznie dostępnych zasobów Polskiego Radia. Strona nie kopiuje go ani nie rozpowszechnia — tylko odsyła do oryginalnego pliku.';
---

<div class="audio-bar" transition:persist="player" data-audio-bar hidden>
  <p class="audio-bar__title" data-audio-title></p>
  <audio
    id="episode-audio"
    controls
    preload="none"
    controlslist="nodownload noplaybackrate"
    disablepictureinpicture
    disableRemotePlayback
  ></audio>
  <div class="audio-bar__skips" role="group" aria-label="Przewijanie">
    <button class="skip" type="button" data-skip="-15" aria-label="Cofnij 15 sekund">−15</button>
    <button class="skip" type="button" data-skip="-5" aria-label="Cofnij 5 sekund">−5</button>
    <button class="skip" type="button" data-skip="5" aria-label="Przewiń 5 sekund">+5</button>
    <button class="skip" type="button" data-skip="15" aria-label="Przewiń 15 sekund">+15</button>
  </div>
  <p class="audio-bar__note" title={note}>
    <span aria-hidden="true">*</span> Nagranie pochodzi z publicznie dostępnych zasobów Polskiego
    Radia. Strona nie kopiuje go ani nie rozpowszechnia — tylko odsyła do oryginalnego pliku.
  </p>
</div>
