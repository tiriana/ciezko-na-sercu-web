  <circle cx="13" cy="13" r="12.5" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
  <path d="M10 7.5 18 13 10 18.5Z" fill="currentColor" />
</svg>
<svg class="track-play__icon track-play__icon--pause" viewBox="0 0 26 26" aria-hidden="true">
  <circle cx="13" cy="13" r="12.5" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
  <rect x="8.4" y="7.5" width="3.2" height="11" fill="currentColor" />
  <rect x="14.4" y="7.5" width="3.2" height="11" fill="currentColor" />
</svg>
