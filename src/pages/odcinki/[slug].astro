---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { getCatalog, getEntries, getEpisodeFiles } from '../../lib/data';
import { formatClock, formatDate, formatEpisodeTitle, formatRole, formatWeekday, pluralTracks } from '../../lib/format';

export async function getStaticPaths() {
  const entries = await getEntries();
  // Katalog jest posortowany od najnowszych, więc „poprzednia" to starsza audycja,
  // a „następna" — nowsza; na krańcach zakresu odpowiedniego linku po prostu nie ma.
  return entries.map((entry, index) => {
    const older = entries[index + 1];
    const newer = entries[index - 1];
    return {
      params: { slug: entry.slug },
      props: {
        entry,
        older: older ? { slug: older.slug, title: formatEpisodeTitle(older.displayTitle) } : null,
        newer: newer ? { slug: newer.slug, title: formatEpisodeTitle(newer.displayTitle) } : null,
      },
    };
  });
}

const { entry, older, newer } = Astro.props;
const [catalog, files] = await Promise.all([getCatalog(), getEpisodeFiles()]);
const episode = files.get(entry.id);

// Tematy i cytaty mają tylko start, więc koniec wyprowadzamy: początek następnej pozycji
// w tej samej sekcji, a dla ostatniej — 30 s, żeby nie świeciła do końca audycji.
const SPAN_TAIL_SEC = 30;

// Pełne wyjaśnienie w atrybucie title: na stronie wystarczy jedno zdanie, ale treść
// musi być dostępna bez rozwijania czegokolwiek.
const AUDIO_NOTE =
  'Nie hostuję ani nie udostępniam tego nagrania. Odtwarzacz odsyła bezpośrednio do pliku ' +
  'udostępnionego publicznie przez Polskie Radio (static.prsa.pl) — tego samego, który gra ' +
  'w playerze na stronie audycji. Nie roszczę sobie żadnych praw do nagrania ani do muzyki. ' +
  'Strona powstała dla fanów muzyki i dla popularyzacji audycji Ciężko na sercu. ' +
  'Jeśli jesteś uprawnionym i nie życzysz sobie tego odsyłacza, napisz — usunę go.';

const spanEnd = (items: { start: number }[], index: number, durationSec: number | null) => {
  const next = items[index + 1];
  const end = next ? next.start : (items[index] as { start: number }).start + SPAN_TAIL_SEC;
  return durationSec ? Math.min(end, durationSec) : end;
};

const topicSpans = (episode?.topics ?? []).map((topic, index) => ({
  ...topic,
  end: spanEnd(episode?.topics ?? [], index, episode?.durationSec ?? null),
}));
const quoteSpans = (episode?.quotes ?? []).map((quote, index) => ({
  ...quote,
  end: spanEnd(episode?.quotes ?? [], index, episode?.durationSec ?? null),
}));

// Program to jedna os czasu: wejścia i utwory przeplatają się tak, jak leciały w audycji.
const programme = [
  ...(episode?.tracks ?? []).map((track, index) => ({
    kind: 'track' as const,
    index: index + 1,
    start: track.start,
    end: track.start + track.durationSec,
    track,
  })),
  ...topicSpans.map((topic) => ({
    kind: 'topic' as const,
    index: null,
    start: topic.start,
    end: topic.end,
    topic,
  })),
].sort((left, right) => left.start - right.start);

// Cytaty z zapowiedzi są policzone i zostają w danych, ale nie pokazujemy ich na stronie.
const SHOW_QUOTES = false;

const speechSec = episode?.durationSec
  ? episode.durationSec - (episode.tracks.reduce((sum, track) => sum + track.durationSec, 0) || 0)
  : null;

const episodeTitle = formatEpisodeTitle(entry.displayTitle);
const title = episode
  ? `${episodeTitle} — ${catalog.program.name}`
  : `${episodeTitle} — opracowanie zaplanowane`;
const description = episode?.summary ?? `Odcinek ${catalog.program.name} z ${formatDate(entry.date)} w indeksie audycji.`;
---

<Base title={title} description={description}>
  <SiteHeader current="episodes" />

  <main class="wrap">
    <nav class="crumbs" aria-label="Ścieżka">
      <a href="/">Odcinki</a>
      <span aria-hidden="true">/</span>
      <span>{entry.date.slice(0, 4)}</span>
    </nav>

    <header class="ep-head">
      <p class="ep-head__date">{formatDate(entry.date)} · {formatWeekday(entry.date)} 00:05 · {catalog.program.station}</p>
      <h1>{episodeTitle}</h1>
      {entry.titleKind === 'unofficial' ? (
        <p class="title-note">
          {entry.titleNote ?? 'Tytuł redakcyjny.'} · Tytuł oryginalny:{' '}
          <span>{formatEpisodeTitle(entry.title)}</span>
        </p>
      ) : entry.titleKind === 'technical' ? (
        <p class="title-note">Tytuł techniczny z katalogu — audycja nie ma własnego tytułu.</p>
      ) : null}
      <div class="ep-head__meta">
        {episode ? (
          <>
            <span class="badge badge--done">opracowany</span>
            {episode.durationSec && <span>{formatClock(episode.durationSec)}</span>}
            <span>{pluralTracks(episode.tracks.length)}</span>
            {episode.quotes.length > 0 && <span>{episode.quotes.length} zapowiedzi</span>}
          </>
        ) : (
          <>
            <span class="badge badge--plain">skatalogowany</span>
          </>
        )}
        {entry.sourceUrl && (
          <a class="btn" href={entry.sourceUrl}>Odcinek w Polskim Radiu ↗</a>
        )}
      </div>
    </header>

    {episode ? (
      <div class="ep-body">
        <div class="stack">
          <section class="card" aria-labelledby="programme-title">
            <h2 id="programme-title">Program audycji</h2>
            <p class="card__sub">
              {pluralTracks(episode.tracks.length)} i {episode.topics.length} wejść w kolejności emisji
            </p>

            {entry.audioUrl && (
              <div class="audio-bar">
                <audio
                  controls
                  preload="none"
                  controlslist="nodownload noplaybackrate"
                  disablepictureinpicture
                  disableRemotePlayback
                  src={entry.audioUrl}
                  data-episode-audio
                ></audio>
                <div class="audio-bar__skips" role="group" aria-label="Przewijanie">
                  <button class="skip" type="button" data-skip="-15" aria-label="Cofnij 15 sekund">−15</button>
                  <button class="skip" type="button" data-skip="-5" aria-label="Cofnij 5 sekund">−5</button>
                  <button class="skip" type="button" data-skip="5" aria-label="Przewiń 5 sekund">+5</button>
                  <button class="skip" type="button" data-skip="15" aria-label="Przewiń 15 sekund">+15</button>
                </div>
                <p class="audio-bar__note" title={AUDIO_NOTE}>
                  <span aria-hidden="true">*</span> Nagranie pochodzi z serwisu Polskiego Radia i jest tam
                  publicznie dostępne — ta strona tylko do niego odsyła.
                </p>
              </div>
            )}

            {programme.length > 0 ? (
              <table class="tracks">
                <thead>
                  <tr>
                    <th scope="col" class="tracks__idx">#</th>
                    <th scope="col">Wykonawca / tytuł</th>
                    <th scope="col">Album</th>
                    <th scope="col" class="tracks__time">Start</th>
                    <th scope="col" class="tracks__time">Czas</th>
                  </tr>
                </thead>
                <tbody>
                  {programme.map((item) => (
                    <tr
                      data-span-start={item.start}
                      data-span-end={item.end}
                      data-kind={item.kind}
                      class:list={{ 'tracks__row--entry': item.kind === 'topic' }}
                    >
                      <td class="tracks__idx">
                        {entry.audioUrl ? (
                          <button
                            class="track-play"
                            type="button"
                            data-track-start={item.start}
                            aria-label={`Odtwórz od ${formatClock(item.start)}`}
                          >
                            <svg class="track-play__icon track-play__icon--play" viewBox="0 0 10 12" aria-hidden="true">
                              <path d="M0 0 10 6 0 12Z" fill="currentColor" />
                            </svg>
                            <svg class="track-play__icon track-play__icon--pause" viewBox="0 0 10 12" aria-hidden="true">
                              <rect x="0" y="0" width="3.5" height="12" fill="currentColor" />
                              <rect x="6.5" y="0" width="3.5" height="12" fill="currentColor" />
                            </svg>
                          </button>
                        ) : (
                          (item.index ?? '')
                        )}
                      </td>
                      {item.kind === 'track' ? (
                        <>
                          <td>
                            <div class="tracks__artist">
                              {item.track.artist ?? <span class="tracks__album">wykonawca nierozpoznany</span>}
                            </div>
                            <div>{item.track.title ?? <span class="tracks__album">tytuł nierozpoznany</span>}</div>
                          </td>
                          <td class="tracks__album">{item.track.album ?? '—'}</td>
                        </>
                      ) : (
                        <>
                          <td>
                            <div class="tracks__kind">Wejście</div>
                            <div>{item.topic.label}</div>
                          </td>
                          <td class="tracks__album">—</td>
                        </>
                      )}
                      <td class="tracks__time">{formatClock(item.start)}</td>
                      <td class="tracks__time">{formatClock(item.end - item.start)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <p class="card__sub">Brak rozpoznanych utworów i wejść w tym odcinku.</p>
            )}
          </section>

          {SHOW_QUOTES && episode.quotes.length > 0 && (
            <section class="card" aria-labelledby="quotes-title">
              <h2 id="quotes-title">Cytaty z zapowiedzi</h2>
              <p class="card__sub">Krótkie fragmenty wypowiedzi prowadzącego, z czasem wejścia</p>
              <ol class="timeline">
                {quoteSpans.map((quote) => (
                  <li data-span-start={quote.start} data-span-end={quote.end} data-kind="quote">
                    {entry.audioUrl ? (
                      <button class="time-link" type="button" data-track-start={quote.start}>
                        {formatClock(quote.start)}
                      </button>
                    ) : (
                      <time>{formatClock(quote.start)}</time>
                    )}
                    <p>{quote.text}</p>
                  </li>
                ))}
              </ol>
            </section>
          )}
        </div>

        <aside class="side">
          {episode.summary && (
            <section class="card" aria-labelledby="summary-title">
              <h2 id="summary-title">Streszczenie</h2>
              <p>{episode.summary}</p>
              <div class="note">Streszczenie wygenerowane przez AI.</div>
            </section>
          )}

          {episode.credits.length > 0 && (
            <section class="card" aria-labelledby="credits-title">
              <h2 id="credits-title">Credits</h2>
              <dl class="kv">
                {episode.credits.map((credit) => (
                  <div>
                    <dt>{formatRole(credit.role)}</dt>
                    <dd>{credit.name}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          <section class="card" aria-labelledby="provenance-title">
            <h2 id="provenance-title">Jak to powstało</h2>
            <dl class="kv">
              <div><dt>Opracowano</dt><dd>{formatDate(episode.analyzedAt)}</dd></div>
              {speechSec && <div><dt>Mowa</dt><dd>{formatClock(speechSec)}</dd></div>}
              <div><dt>Utwory</dt><dd>{episode.tracks.length}</dd></div>
              <div><dt>Zapowiedzi w audycji</dt><dd>{episode.quotes.length}</dd></div>
            </dl>
          </section>

          <section class="card">
            <h2>Odtwarzanie</h2>
            <p class="card__sub">Odcinek jest dostępny w serwisie Polskiego Radia.</p>
            <a class="btn btn--solid" href={entry.sourceUrl ?? catalog.program.pageUrl}>
              {entry.sourceUrl ? 'Otwórz odcinek ↗' : 'Otwórz audycję ↗'}
            </a>
          </section>
        </aside>
      </div>
    ) : (
      <section class="card card--planned" aria-labelledby="planned-title">
        <h2 id="planned-title">Opracowanie jeszcze nie powstało</h2>
        <p class="card__sub">
          Ten odcinek jest w indeksie, ale nie ma jeszcze tracklisty ani streszczenia. Opracowania
          powstają po kolei — tempo i kolejność opisuje plan projektu.
        </p>
        {entry.sourceUrl && (
          <a class="btn btn--solid" href={entry.sourceUrl}>Posłuchaj w Polskim Radiu ↗</a>
        )}
      </section>
    )}
    <nav class="ep-nav" aria-label="Sąsiednie audycje">
      {older ? (
        <a class="ep-nav__link" href={`/odcinki/${older.slug}/`}>
          <span class="ep-nav__label">← Poprzednia audycja</span>
          <span class="ep-nav__title">{older.title}</span>
        </a>
      ) : (
        <span />
      )}
      {newer ? (
        <a class="ep-nav__link ep-nav__link--next" href={`/odcinki/${newer.slug}/`}>
          <span class="ep-nav__label">Następna audycja →</span>
          <span class="ep-nav__title">{newer.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  </main>

  <SiteFooter />
</Base>
