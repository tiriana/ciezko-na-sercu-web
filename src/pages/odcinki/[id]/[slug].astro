---
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import Base from '../../../layouts/Base.astro';
import PersonName from '../../../components/PersonName.astro';
import ReportLink from '../../../components/ReportLink.astro';
import FragmentProgress from '../../../components/FragmentProgress.astro';
import TrackPlayIcon from '../../../components/TrackPlayIcon.astro';
import EpisodePlay from '../../../components/EpisodePlay.astro';
import { getCatalog, getDuplicates, getEntries, getEpisodeFiles, getTranscripts } from '../../../lib/data';
import { transcriptParagraphs } from '../../../lib/transcript';
import { tagId } from '../../../lib/tags';
import {
  formatClock,
  formatDate,
  formatDateTime,
  resolveDisplayTitle,
  episodePath,
  formatRole,
  formatWeekday,
  fragmentSlug,
  pluralEntries,
  pluralThreads,
  pluralTracks,
} from '../../../lib/format';

export async function getStaticPaths() {
  const [all, visible, duplicates] = await Promise.all([
    getEntries({ includeHidden: true }),
    getEntries(),
    getDuplicates(),
  ]);
  const audioEpisodes = visible
    .filter((item) => item.audioUrl)
    .map((item) => ({ src: item.audioUrl!, slug: item.slug, path: episodePath(item), title: resolveDisplayTitle(item) }));
  // Katalog jest posortowany od najnowszych, więc „poprzednia" to starsza audycja,
  // a „następna" — nowsza; na krańcach zakresu odpowiedniego linku po prostu nie ma.
  // Sąsiedzi liczą się po widocznych odcinkach, żeby ukryty duplikat nie trafiał do nawigacji.
  return all.map((entry) => {
    const index = visible.findIndex((item) => item.id === entry.id);
    const older = index >= 0 ? visible[index + 1] : undefined;
    const newer = index >= 0 ? visible[index - 1] : undefined;
    const duplicate = duplicates[entry.id];
    return {
      params: { id: entry.id.slice(0, 8), slug: entry.slug },
      props: {
        entry,
        audioEpisodes,
        older: older ? { path: episodePath(older), title: resolveDisplayTitle(older) } : null,
        newer: newer ? { path: episodePath(newer), title: resolveDisplayTitle(newer) } : null,
        duplicate: duplicate
          ? {
              reason: duplicate.reason,
              path: (() => {
                const target = all.find((item) => item.id === duplicate.of);
                return target ? episodePath(target) : null;
              })(),
              title: all.find((item) => item.id === duplicate.of)?.displayTitle ?? null,
            }
          : null,
      },
    };
  });
}

const { entry, audioEpisodes, older, newer, duplicate } = Astro.props;
const [catalog, files, transcripts] = await Promise.all([getCatalog(), getEpisodeFiles(), getTranscripts()]);
const episode = files.get(entry.id);
const paragraphs = transcriptParagraphs(transcripts.get(entry.id));
// Nieopracowany to odcinek bez pliku opracowania albo z plikiem-zaślepką, w którym nie ma
// jeszcze ani utworów, ani wejść. Tabela z samym nagłówkiem nic by nie mówiła.
const unprocessed = !episode || (episode.tracks.length === 0 && episode.topics.length === 0);

// Tematy i cytaty mają tylko start, więc koniec wyprowadzamy: początek następnej pozycji
// w tej samej sekcji, a dla ostatniej — 30 s, żeby nie świeciła do końca audycji.
const SPAN_TAIL_SEC = 30;

// Pełne wyjaśnienie w atrybucie title: na stronie wystarczy jedno zdanie, ale treść
// musi być dostępna bez rozwijania czegokolwiek.
const AUDIO_NOTE =
  'Odtwarzacz odsyła bezpośrednio do pliku udostępnionego publicznie przez Polskie Radio — ' +
  'tego samego, który gra w playerze na stronie audycji. Nagranie nie jest kopiowane, ' +
  'hostowane ani transmitowane przez tę stronę. Nie roszczę sobie praw do nagrania ani do ' +
  'muzyki. Strona jest nieoficjalnym indeksem, tworzonym dla słuchaczy audycji. ' +
  'Jeśli jesteś uprawnionym i nie życzysz sobie odsyłacza, napisz na adres redakcji — usunę go.';

const spanEnd = (items: { start: number }[], index: number, durationSec: number | null) => {
  const next = items[index + 1];
  const end = next ? next.start : (items[index] as { start: number }).start + SPAN_TAIL_SEC;
  return durationSec ? Math.min(end, durationSec) : end;
};

// Początek utworu zawsze kończy wejście, nawet jeśli zapisany koniec mówi inaczej —
// inaczej wejście „przeciąga się” przez cały blok muzyczny do następnego wątku.
// Własny (wcześniejszy) koniec z poprawek zostaje, bo bywa świadomym cięciem.
const programStarts = [
  ...(episode?.tracks ?? []).map((track) => track.start),
  ...(episode?.topics ?? []).map((topic) => topic.start),
].sort((left, right) => left - right);

// Długość liczymy zawsze do następnego znacznika — nie z zapisanego `end` ani
// `durationSec`, bo te bywają nieaktualne po przesunięciu sąsiada. Ostatnia pozycja
// nie ma następnika, więc tam dopiero sięgamy po zapisane granice.
const nextStartOf = (start: number) => programStarts.find((candidate) => candidate > start + 0.001) ?? null;

const topicSpans = (episode?.topics ?? []).map((topic, index) => {
  const nextStart = nextStartOf(topic.start);
  const derived = spanEnd(episode?.topics ?? [], index, episode?.durationSec ?? null);
  const fallback = topic.end ?? derived;
  const end = nextStart ?? (episode?.durationSec ? Math.min(fallback, episode.durationSec) : fallback);
  return { ...topic, end: Math.max(end, topic.start) };
});
const quoteSpans = (episode?.quotes ?? []).map((quote, index) => ({
  ...quote,
  end: spanEnd(episode?.quotes ?? [], index, episode?.durationSec ?? null),
}));

// Program to jedna os czasu: wejścia i utwory przeplatają się tak, jak leciały w audycji.
type TopicSpan = (typeof topicSpans)[number];

// Tag trafia w wejście, gdy jego wzmianka wypada w tym fragmencie albo gdy etykieta
// jest wprost w opisie wątku. Tagi utworów mają `at` równy startowi utworu, więc nie
// podpowiadają wejść po czasie — tylko po nazwie.
const topicTagIds = (topic: TopicSpan): string[] =>
  (episode?.tags ?? [])
    .filter((tag) => {
      const byTime = tag.source !== 'tracks' && tag.at != null && tag.at >= topic.start - 2 && tag.at <= topic.end + 2;
      const byLabel = tag.label.length >= 3 && topic.label.toLowerCase().includes(tag.label.toLowerCase());
      return byTime || byLabel;
    })
    .map((tag) => tag.id);
type TrackItem = NonNullable<typeof episode>['tracks'][number];

interface TrackBlock {
  kind: 'track';
  index: number;
  start: number;
  end: number;
  track: TrackItem;
}

interface GroupBlock {
  kind: 'group';
  start: number;
  end: number;
  topics: TopicSpan[];
}

const items: (TrackBlock | (TopicSpan & { kind: 'topic' }))[] = [
  ...(episode?.tracks ?? []).map((track, index) => ({
    kind: 'track' as const,
    index: index + 1,
    start: track.start,
    end: nextStartOf(track.start) ?? track.end ?? track.start + track.durationSec,
    track,
  })),
  ...topicSpans.map((topic) => ({ kind: 'topic' as const, ...topic })),
].sort((left, right) => left.start - right.start || (left.kind === 'track' ? -1 : 1));

// Kolejne wejścia bez utworu pomiędzy nimi to dla słuchacza jeden fragment programu:
// dostają jeden play, a wątki zostają klikalne osobno.
const GROUP_MAX_GAP_SEC = 60;

const blocks: (TrackBlock | GroupBlock | (TopicSpan & { kind: 'topic' }))[] = [];
for (const item of items) {
  const previous = blocks[blocks.length - 1];
  const isTopicRun = item.kind === 'topic' && (previous?.kind === 'topic' || previous?.kind === 'group');
  const gap = isTopicRun ? item.start - (previous as TopicSpan & { kind: 'topic' }).end : Infinity;

  if (item.kind === 'topic' && previous?.kind === 'group' && gap <= GROUP_MAX_GAP_SEC) {
    previous.topics.push(item);
    previous.end = Math.max(previous.end, item.end);
    continue;
  }

  if (item.kind === 'topic' && previous?.kind === 'topic' && gap <= GROUP_MAX_GAP_SEC) {
    blocks.pop();
    blocks.push({ kind: 'group', start: previous.start, end: Math.max(previous.end, item.end), topics: [previous, item] });
    continue;
  }

  blocks.push(item);
}

// Adres podaje fragment (`?f=`), więc każdy odtwarzalny wiersz dostaje stabilny
// identyfikator z tytułu; powtórki na tej samej stronie rozróżnia przyrostek.
const usedFragmentIds = new Set<string>();
const fragmentId = (text: string) => {
  const base = fragmentSlug(text) || 'fragment';
  let id = base;
  for (let n = 2; usedFragmentIds.has(id); n += 1) id = `${base}-${n}`;
  usedFragmentIds.add(id);
  return id;
};

// Grupa wejść to jeden fragment, więc wiersz dostaje identyfikator pierwszego wątku.
// Pozostałe wątki nie są już pokazywane, ale ich identyfikatory nadal rezerwujemy,
// żeby widoczne fragmenty nie zmieniły adresów.
const groupIds = new Map<GroupBlock, string[]>();
for (const block of blocks) {
  if (block.kind === 'group') groupIds.set(block, block.topics.map((topic) => fragmentId(topic.label)));
}

// Sekcje o zerowej długości (te same znaczniki czasu z modelu) nie mają sensu jako
// osobne wiersze — w grupie zostają treścią, a czas pokazujemy jako „—".
const formatSpan = (start: number, end: number) => (end - start < 1 ? '—' : formatClock(end - start));

// Cytaty z zapowiedzi są policzone i zostają w danych, ale nie pokazujemy ich na stronie.
const SHOW_QUOTES = false;

// Mowa to suma długości wejść: od znacznika wejścia do najbliższego następnego
// znacznika (utworu albo kolejnego wejścia). Odejmowanie muzyki od całości liczyło
// też ciszę i ogon nagrania, więc zaniżało i mieszało się z resztą programu.
const speechSec = topicSpans.length > 0
  ? Math.round(topicSpans.reduce((sum, span) => sum + Math.max(0, span.end - span.start), 0))
  : (episode?.durationSec
    ? episode.durationSec - (episode.tracks.reduce((sum, track) => sum + track.durationSec, 0) || 0)
    : null);

// Produkcja i wydawca to zwykle ta sama osoba, a wydawca mówi więcej — rolę
// „producent" pomijamy, gdy występuje razem z „wydawca" przy tym samym nazwisku.
const creditRows = (() => {
  const publisherNames = new Set(
    (episode?.credits ?? []).filter((credit) => credit.role === 'wydawca').map((credit) => credit.name)
  );
  const visible = (episode?.credits ?? []).filter(
    (credit) => !(credit.role === 'producent' && publisherNames.has(credit.name))
  );

  const byName = new Map<string, { name: string; roles: string[]; time: number }>();
  for (const credit of visible) {
    const row = byName.get(credit.name);
    if (!row) {
      byName.set(credit.name, { name: credit.name, roles: [credit.role], time: credit.time });
      continue;
    }
    if (!row.roles.includes(credit.role)) row.roles.push(credit.role);
  }
  return [...byName.values()].sort((left, right) => left.time - right.time);
})();

const episodeTitle = resolveDisplayTitle(entry);
const title = episode
  ? `${episodeTitle} — ${catalog.program.name}`
  : `${episodeTitle} — opracowanie zaplanowane`;
const description = episode?.summary ?? `Odcinek ${catalog.program.name} z ${formatDate(entry.date)} w indeksie audycji.`;
---

<Base title={title} description={description}>
  <SiteHeader current="episodes" />

  <main class="wrap">
    <nav class="crumbs" aria-label="Ścieżka">
      <a href="/">Odcinki</a>
      <span aria-hidden="true">/</span>
      <span>{entry.date.slice(0, 4)}</span>
    </nav>

    <header class="ep-head">
      <p class="ep-head__date">{formatDate(entry.date)} · {formatWeekday(entry.date)} 00:05 · {catalog.program.station}</p>
      {duplicate && (
        <p class="duplicate-note">
          Ten odcinek dubluje{' '}
          {duplicate.slug ? (
            <a href={duplicate.path}>{duplicate.title}</a>
          ) : (
            <span>{duplicate.title}</span>
          )}
          . {duplicate.reason}
        </p>
      )}

      <div class="ep-head__title">
        {entry.audioUrl && (
          <EpisodePlay
            src={entry.audioUrl}
            slug={entry.slug}
            title={episodeTitle}
            class="ep-head__play"
          />
        )}
        <h1>{episodeTitle}</h1>
      </div>
      {entry.titleKind === 'unofficial' ? (
        <p class="title-note">
          {entry.titleNote ?? 'Tytuł redakcyjny.'} · Tytuł oryginalny:{' '}
          <span>{resolveDisplayTitle({ title: entry.title })}</span>
        </p>
      ) : entry.titleKind === 'technical' ? (
        <p class="title-note">Tytuł techniczny z katalogu — audycja nie ma własnego tytułu.</p>
      ) : null}
      <div class="ep-head__meta">
        {episode && (
          <>
            {episode.durationSec && <span>{formatClock(episode.durationSec)}</span>}
            <span>{pluralTracks(episode.tracks.length)}</span>
            {episode.topics.length > 0 && <span>{pluralEntries(episode.topics.length)}</span>}
          </>
        )}
        {entry.sourceUrl && (
          <a class="btn" href={entry.sourceUrl} target="_blank" rel="noopener noreferrer">Odcinek w Polskim Radiu ↗</a>
        )}
        <ReportLink element={`${entry.slug}|odcinek`} label="Zgłoś błąd" class="report-link--head" />
      </div>
    </header>

    {episode ? (
      <div class="ep-body">
        <div class="stack">
          <section class="card programme" aria-labelledby="programme-title">
            <h2 id="programme-title">Program audycji</h2>
            <div class="programme__head" hidden={unprocessed}>
              <p class="card__sub">
                {pluralTracks(episode.tracks.length)} i {pluralEntries(episode.topics.length)} w kolejności emisji
              </p>
              <label class="switch">
                <input class="switch__input" type="checkbox" role="switch" id="show-entries" checked />
                <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
                <span class="switch__label">Pokazuj wejścia</span>
              </label>
            </div>

            {entry.audioUrl && (
              <script
                type="application/json"
                id="audio-data"
                set:html={JSON.stringify({ src: entry.audioUrl, title: episodeTitle, slug: entry.slug, path: episodePath(entry) })}
              />
            )}
            {entry.audioUrl && (
              <script type="application/json" id="audio-catalog-data" set:html={JSON.stringify(audioEpisodes)} />
            )}

            {unprocessed ? (
              <div class="unprocessed">
                <p class="unprocessed__line">Tracklista pojawi się wkrótce.</p>
                <p class="card__sub">Możesz już posłuchać całej audycji.</p>
                {entry.audioUrl && (
                  <p class="unprocessed__actions">
                    <button
                      class="btn btn--solid unprocessed__play"
                      type="button"
                      data-episode-play
                      data-audio-src={entry.audioUrl}
                      data-audio-slug={entry.slug}
                      data-audio-title={episodeTitle}
                      data-label="Cała audycja"
                      data-stop-label="Zatrzymaj audycję"
                      aria-label="Cała audycja"
                    >
                      <TrackPlayIcon />
                      <span data-play-text>Cała audycja</span>
                    </button>
                  </p>
                )}
              </div>
            ) : blocks.length > 0 ? (
              <table class="tracks">
                <thead>
                  <tr>
                    <th scope="col" class="tracks__idx">#</th>
                    <th scope="col">Wykonawca / tytuł</th>
                    <th scope="col">Album</th>
                    <th scope="col" class="tracks__time">Start</th>
                    <th scope="col" class="tracks__time">Czas</th>
                  </tr>
                </thead>
                <tbody>
                  {blocks.map((block) =>
                    block.kind === 'track' ? (
                      <tr
                        data-span-start={block.start}
                        data-span-end={block.end}
                        data-kind="track"
                        data-fragment-id={fragmentId([block.track.artist, block.track.title].filter(Boolean).join(' ') || 'utwór')}
                        data-tag-ids={block.track.artist ? tagId(block.track.artist) : undefined}
                        data-track-label={[block.track.artist, block.track.title].filter(Boolean).join(' — ')}
                      >
                        <td class="tracks__idx">
                          {entry.audioUrl ? (
                            <button
                              class="track-play"
                              type="button"
                              data-track-start={block.start}
                              aria-label={`Odtwórz od ${formatClock(block.start)}`}
                            >
                              <TrackPlayIcon />
                            </button>
                          ) : (
                            block.index
                          )}
                        </td>
                        <td>
                          <div class="tracks__artist">
                            {block.track.artist ?? <span class="tracks__album">wykonawca nierozpoznany</span>}
                          </div>
                          <div class:list={['tracks__title-line', block.track.unrecognized && 'tracks__title-line--unrecognized']}>
                            <span class:list={['tracks__title-text', block.track.unrecognized && 'tracks__title-text--unrecognized']}>
                            {block.track.title ?? <span class="tracks__album">tytuł nierozpoznany</span>}
                            </span>
                            {block.track.unrecognized && (
                              <span class="tracks__unrecognized" title="Nie udało się rozpoznać utworu — tylko wykonawca">
                                nierozpoznana
                              </span>
                            )}
                            <ReportLink
                              element={`${entry.slug}|utwór:${block.index}|${[block.track.artist, block.track.title].filter(Boolean).join(' — ')}`}
                              class="report-link--row"
                            />
                          </div>
                          {block.end > block.start && <FragmentProgress />}
                        </td>
                        <td class="tracks__album">{block.track.album ?? '—'}</td>
                        <td class="tracks__time">{formatClock(block.start)}</td>
                        <td class="tracks__time">{formatSpan(block.start, block.end)}</td>
                      </tr>
                    ) : block.kind === 'group' ? (
                      <tr
                        class="tracks__row--entry"
                        data-span-start={block.start}
                        data-span-end={block.end}
                        data-kind="topic"
                        data-fragment-id={groupIds.get(block)?.[0]}
                        data-tag-ids={[...new Set(block.topics.flatMap((topic) => topicTagIds(topic)))].join(' ') || undefined}
                      >
                        <td class="tracks__idx">
                          {entry.audioUrl ? (
                            <button
                              class="track-play"
                              type="button"
                              data-track-start={block.start}
                              aria-label={`Odtwórz od ${formatClock(block.start)}`}
                            >
                              <TrackPlayIcon />
                            </button>
                          ) : null}
                        </td>
                        <td>
                          <div class="tracks__kind">Wejście · {pluralThreads(block.topics.length)}</div>
                          {/* Kolejne wejścia pod rząd dają jeden wiersz z tytułem pierwszego:
                              pełna lista zajmowała więcej miejsca niż wnosiła. Pełny tytuł
                              zostaje w `title`, więc nadal jest dostępny z klawiatury i myszą. */}
                          <div class="tracks__entry-line">
                            <div class="tracks__entry-label" title={block.topics[0].label}>{block.topics[0].label}</div>
                            <ReportLink
                              element={`${entry.slug}|wejście:${block.topics[0].start}|${block.topics[0].label}`}
                              class="report-link--row"
                            />
                          </div>
                          {block.end > block.start && <FragmentProgress />}
                        </td>
                        <td class="tracks__album">—</td>
                        <td class="tracks__time">{formatClock(block.start)}</td>
                        <td class="tracks__time">{formatSpan(block.start, block.end)}</td>
                      </tr>
                    ) : (
                      <tr
                        class="tracks__row--entry"
                        data-span-start={block.start}
                        data-span-end={block.end}
                        data-kind="topic"
                        data-fragment-id={fragmentId(block.label)}
                        data-tag-ids={topicTagIds(block).join(' ') || undefined}
                      >
                        <td class="tracks__idx">
                          {entry.audioUrl ? (
                            <button
                              class="track-play"
                              type="button"
                              data-track-start={block.start}
                              aria-label={`Odtwórz od ${formatClock(block.start)}`}
                            >
                              <TrackPlayIcon />
                            </button>
                          ) : null}
                        </td>
                        <td>
                          <div class="tracks__kind">Wejście</div>
                          <div>
                            {block.label}
                            <ReportLink element={`${entry.slug}|wejście:${block.start}|${block.label}`} class="report-link--row" />
                          </div>
                          {block.end > block.start && <FragmentProgress />}
                        </td>
                        <td class="tracks__album">—</td>
                        <td class="tracks__time">{formatClock(block.start)}</td>
                        <td class="tracks__time">{formatSpan(block.start, block.end)}</td>
                      </tr>
                    )
                  )}
                </tbody>
              </table>
            ) : (
              <p class="card__sub">Brak rozpoznanych utworów i wejść w tym odcinku.</p>
            )}
          </section>

          {paragraphs.length > 0 && (
            <section class="card" id="transkrypcja" aria-labelledby="transcript-title">
              <h2 id="transcript-title">Transkrypcja</h2>
              <p class="card__sub">
                Zapis mowy z audycji powstały automatycznie. Nazwiska i tytuły mogą być przekręcone.
              </p>
              <details class="transcript">
                <summary class="transcript__summary">
                  Cały tekst · {paragraphs.length} {paragraphs.length === 1 ? 'akapit' : paragraphs.length < 5 ? 'akapity' : 'akapitów'}
                  <ReportLink element={`${entry.slug}|transkrypt`} class="report-link--summary" />
                </summary>
                <div class="transcript__body">
                  {paragraphs.map((paragraph) => (
                    <p class="transcript__paragraph">
                      {entry.audioUrl ? (
                        <button class="time-link" type="button" data-track-start={paragraph.start}>
                          {formatClock(paragraph.start)}
                        </button>
                      ) : (
                        <span class="transcript__time">{formatClock(paragraph.start)}</span>
                      )}
                      <span>
                        {paragraph.text}
                        <ReportLink
                          element={`${entry.slug}|transkrypt:${Math.floor(paragraph.start)}`}
                          target={`Transkrypt od ${formatClock(paragraph.start)}`}
                          class="report-link--para"
                        />
                      </span>
                    </p>
                  ))}
                </div>
              </details>
            </section>
          )}

          {SHOW_QUOTES && episode.quotes.length > 0 && (
            <section class="card" aria-labelledby="quotes-title">
              <h2 id="quotes-title">Cytaty z zapowiedzi</h2>
              <p class="card__sub">Krótkie fragmenty wypowiedzi prowadzącego, z czasem wejścia</p>
              <ol class="timeline">
                {quoteSpans.map((quote) => (
                  <li data-span-start={quote.start} data-span-end={quote.end} data-kind="quote">
                    {entry.audioUrl ? (
                      <button class="time-link" type="button" data-track-start={quote.start}>
                        {formatClock(quote.start)}
                      </button>
                    ) : (
                      <time>{formatClock(quote.start)}</time>
                    )}
                    <p>
                      {quote.text}
                    </p>
                  </li>
                ))}
              </ol>
            </section>
          )}
        </div>

        <aside class="side">
          {episode.summary && (
            <section class="card" aria-labelledby="summary-title">
              <h2 id="summary-title">Streszczenie</h2>
              <p>{episode.summary}</p>
              <div class="note">Streszczenie wygenerowane przez AI.</div>
            </section>
          )}

          {episode.credits.length > 0 && (
            <section class="card" aria-labelledby="credits-title">
              <h2 id="credits-title">Credits</h2>
              <dl class="kv">
                {creditRows.map((row) => (
                  <div>
                    <dt>{row.roles.map(formatRole).join(' / ')}</dt>
                    <dd><PersonName name={row.name} tags={episode.tags} /></dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          <section class="card" aria-labelledby="provenance-title">
            <h2 id="provenance-title">Jak to powstało</h2>
            <dl class="kv">
              <div><dt>Opracowano</dt><dd>{formatDate(episode.analyzedAt)}</dd></div>
              {episode.updatedAt && <div><dt>Ostatnia aktualizacja</dt><dd>{formatDateTime(episode.updatedAt)}</dd></div>}
              {speechSec && <div><dt>Mowa</dt><dd>{formatClock(speechSec)}</dd></div>}
              <div><dt>Utwory</dt><dd>{episode.tracks.length}</dd></div>
              <div><dt>Zapowiedzi w audycji</dt><dd>{episode.quotes.length}</dd></div>
            </dl>
          </section>

          <section class="card">
            <h2>Odtwarzanie</h2>
            <p class="card__sub">Odcinek jest dostępny w serwisie Polskiego Radia.</p>
            <a class="btn btn--solid" href={entry.sourceUrl ?? catalog.program.pageUrl} target="_blank" rel="noopener noreferrer">
              {entry.sourceUrl ? 'Otwórz odcinek ↗' : 'Otwórz audycję ↗'}
            </a>
          </section>

          {episode.tags.length > 0 && (
            <p class="side__tags" aria-label="Tagi audycji">
              {episode.tags.map((tag, index) => (
                <>{index > 0 ? ' · ' : ''}<a href={`/tagi/${tag.id}/`}>{tag.label}</a></>
              ))}
            </p>
          )}
        </aside>
      </div>
    ) : (
      <section class="card card--planned" aria-labelledby="planned-title">
        <h2 id="planned-title">Program audycji</h2>
        <div class="unprocessed">
          <p class="unprocessed__line">Tracklista pojawi się wkrótce.</p>
          <p class="card__sub">Możesz już posłuchać całej audycji.</p>
          {entry.audioUrl && (
            <p class="unprocessed__actions">
              <button
                class="btn btn--solid unprocessed__play"
                type="button"
                data-episode-play
                data-audio-src={entry.audioUrl}
                data-audio-slug={entry.slug}
                data-audio-title={episodeTitle}
                data-label="Cała audycja"
                data-stop-label="Zatrzymaj audycję"
                aria-label="Cała audycja"
              >
                <TrackPlayIcon />
                <span data-play-text>Cała audycja</span>
              </button>
              <a class="btn" href={entry.sourceUrl ?? catalog.program.pageUrl} target="_blank" rel="noopener noreferrer">Polskie Radio ↗</a>
            </p>
          )}
        </div>
      </section>
    )}
    <nav class="ep-nav" aria-label="Sąsiednie audycje">
      {newer ? (
        <a class="ep-nav__link" href={newer.path}>
          <span class="ep-nav__label">← Nowsza audycja</span>
          <span class="ep-nav__title">{newer.title}</span>
        </a>
      ) : (
        <span />
      )}
      {older ? (
        <a class="ep-nav__link ep-nav__link--next" href={older.path}>
          <span class="ep-nav__label">Starsza audycja →</span>
          <span class="ep-nav__title">{older.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  </main>

  <SiteFooter />
  <script>
    import '../../../scripts/report.js';
  </script>
</Base>
