---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Base from '../layouts/Base.astro';
import PersonName from '../components/PersonName.astro';
import EpisodePlay from '../components/EpisodePlay.astro';
import { getCatalog, getEntries, getEpisodeFiles } from '../lib/data';
import { formatDay, formatEpisodeTitle, monthKey, monthLabel, resolveDisplayTitle } from '../lib/format';

const [catalog, entries, files] = await Promise.all([getCatalog(), getEntries(), getEpisodeFiles()]);

// Producent i wydawca bywają wymieniani różnie w różnych odcinkach, więc pokazujemy
// wszystkich, których tagger znalazł w creditsach — bez powtórzeń.
const creditNames = (role: string) =>
  [...new Set([...files.values()].flatMap((episode) => episode.credits.filter((credit) => credit.role === role).map((credit) => credit.name)))];
const publishers = creditNames('wydawca');
const enriched = entries.filter((entry) => entry.enriched);
const years = [...new Set(entries.map((entry) => entry.date.slice(0, 4)))];

const months = new Map<string, typeof entries>();
for (const entry of entries) {
  const key = monthKey(entry.date);
  if (!months.has(key)) months.set(key, []);
  months.get(key)!.push(entry);
}
---

<Base
  title={`${catalog.program.name} — katalog odcinków`}
  description={`Katalog odcinków audycji „${catalog.program.name}” z ${catalog.program.station}: lista, opracowania, rozpoznane utwory.`}
>
  <SiteHeader current="episodes" />

  <main>
    <section class="hero">
      <div class="wrap hero__grid">
        <div>
          <p class="eyebrow">{catalog.program.station} · środa 00:05</p>
          <h1 class="wordmark"><span>Ciężko</span><span>na sercu</span></h1>
          <p class="hero__lead">
            Indeks odcinków audycji o ciężkim graniu. Każdy odcinek ma własną stronę: program
            z wejściami i utworami, streszczenie i wykonawców.
          </p>
        </div>

        <aside class="panel">
          <h2 class="panel__title">O audycji</h2>
          <p>
            Cotygodniowy przegląd ciężkiego grania: premiery, klasyka gatunku, sceny lokalne
            i rozmowy z ludźmi, którzy tę muzykę tworzą. Bez gatunkowych klapek — od doomu
            po eksperyment.
          </p>
          <dl class="facts">
            <div><dt>Prowadzący</dt><dd><PersonName name="Jarek Szubrycht" /></dd></div>
            {publishers.length > 0 && (
              <div>
                <dt>Wydawca</dt>
                <dd>{publishers.map((name, index) => <><PersonName name={name} />{index < publishers.length - 1 ? ', ' : ''}</>)}</dd>
              </div>
            )}
            <div><dt>Stacja</dt><dd>{catalog.program.station}</dd></div>
            <div><dt>Emisja</dt><dd>środa, 00:05</dd></div>
            <div><dt>Kontakt</dt><dd><a href="mailto:ciezko@polskieradio.pl">ciezko@polskieradio.pl</a></dd></div>
          </dl>
        </aside>
      </div>
    </section>

    <div class="wrap" style="padding-top: 40px">
      <div class="toolbar">
        <label class="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m16.5 16.5 4 4" />
          </svg>
          <span class="visually-hidden">Szukaj odcinka</span>
          <input type="search" placeholder="Szukaj po tytule…" data-filter-title />
        </label>
        <div class="chips" role="group" aria-label="Rok">
          <button class="chip-filter" type="button" data-year="all" aria-pressed="true">Wszystkie</button>
          {years.map((year) => (
            <button class="chip-filter" type="button" data-year={year} aria-pressed="false">{year}</button>
          ))}
        </div>
        <p class="toolbar__progress">
          <strong data-result-count>{entries.length}</strong> odcinków
        </p>
      </div>

      <div class="section-head">
        <h2>Odcinki</h2>
        <p>najnowsze pierwsze</p>
      </div>

      <div class="list">
        {[...months.entries()].map(([key, group]) => (
          <>
            <div class="list__month" data-month={key}>{monthLabel(group[0].date)}</div>
            {group.map((entry) => (
              <article
                class="episode-row"
                data-episode={resolveDisplayTitle(entry)}
                data-date={entry.date}
                data-month={key}
                data-audio-slug={entry.slug}
              >
                {entry.audioUrl ? (
                  <EpisodePlay
                    src={entry.audioUrl}
                    slug={entry.slug}
                    title={resolveDisplayTitle(entry)}
                    class="episode-row__play"
                  />
                ) : (
                  <span class="episode-row__play episode-row__play--empty" aria-hidden="true" />
                )}
                <div class="episode-row__date">{formatDay(entry.date)}</div>
                <div class="episode-row__main">
                  <h3 class="episode-row__title">
                    <a href={`/odcinki/${entry.slug}/`}>{resolveDisplayTitle(entry)}</a>
                    {entry.titleKind !== 'official' && (
                      <span class="title-flag" title={`W katalogu: ${formatEpisodeTitle(entry.title)}`}>
                        {entry.titleKind === 'unofficial' ? 'tytuł nieoficjalny' : 'tytuł techniczny'}
                      </span>
                    )}
                  </h3>
                </div>
                <div class="episode-row__actions">
                  <a class="btn btn--solid" href={`/odcinki/${entry.slug}/`}>Strona odcinka</a>
                  {!entry.enriched && entry.sourceUrl && (
                    <a class="btn" href={entry.sourceUrl} target="_blank" rel="noopener noreferrer">Polskie Radio ↗</a>
                  )}
                </div>
              </article>
            ))}
          </>
        ))}
      </div>

      <p class="list__empty" data-empty hidden>Brak odcinków pasujących do wyszukiwania.</p>
    </div>
  </main>

  <SiteFooter />
</Base>
