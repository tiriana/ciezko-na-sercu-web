---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
import { getEntries, getEpisodeFiles } from '../../lib/data';
import { formatDate, formatEpisodeTitle } from '../../lib/format';
import { TAG_TYPE_LABELS, buildTagIndex } from '../../lib/tags';

export async function getStaticPaths() {
  const [entries, files] = await Promise.all([getEntries(), getEpisodeFiles()]);
  const index = buildTagIndex(files, entries);
  return [...index.values()].map((tag) => ({ params: { id: tag.id }, props: { tag } }));
}

const { tag } = Astro.props;
const typeLabel = TAG_TYPE_LABELS[tag.type];
---

<Base title={`${tag.label} — tagi`} description={`Odcinki audycji, w których pojawił się tag ${tag.label}.`}>
  <SiteHeader />

  <main class="wrap">
    <p class="page-back"><a href="/tagi/">← Wszystkie tagi</a></p>
    <h1 class="page-title">{tag.label}</h1>
    <p class="page-lead">{typeLabel} · {tag.episodes.length} {tag.episodes.length === 1 ? 'odcinek' : 'odcinków'}</p>

    <ul class="tag-episodes">
      {tag.episodes.map((episode) => (
        <li>
          <a href={`/odcinki/${episode.slug}/?tag=${tag.id}`}>
            <time datetime={episode.date}>{formatDate(episode.date)}</time>
            <span>{formatEpisodeTitle(episode.title)}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <SiteFooter />
</Base>
