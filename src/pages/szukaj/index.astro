---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Base from '../../layouts/Base.astro';
---

<Base title="Szukaj" description="Szukaj audycji po zespole, osobie, wydarzeniu albo tytule odcinka.">
  <SiteHeader current="search" />

  <main class="wrap">
    <h1 class="page-title">Szukaj</h1>
    <p class="page-lead">Zespół, osoba, wydarzenie albo tytuł odcinka. Wpisz co najmniej dwa znaki.</p>

    <form class="search" role="search" onsubmit="return false">
      <div class="search__field">
        <input
          id="search-input"
          class="search__input"
          type="search"
          name="q"
          placeholder="np. Vader, Roadburn, Obituary"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="search-suggestions"
          aria-autocomplete="list"
          aria-describedby="search-status"
        />
        <ul id="search-suggestions" class="search__suggestions" role="listbox" hidden></ul>
      </div>
      <p id="search-status" class="search__status" aria-live="polite"></p>
    </form>

    <ul id="search-results" class="search__results"></ul>
  </main>

  <SiteFooter />
</Base>

<script>
  import { matches, normalize, type SearchEntry } from '../../lib/search';

  const input = document.querySelector<HTMLInputElement>('#search-input');
  const status = document.querySelector<HTMLParagraphElement>('#search-status');
  const list = document.querySelector<HTMLUListElement>('#search-results');
  const suggestions = document.querySelector<HTMLUListElement>('#search-suggestions');

  if (input && status && list && suggestions) {
    let entries: SearchEntry[] = [];
    let ready = false;
    // Podpowiedzi to tagi z licznikiem odcinków: nazwa zespołu bywa dłuższa niż tytuł,
    // więc użytkownik wybiera istniejący tag zamiast wpisywać go z pamięci.
    let tags: { id: string; label: string; count: number; haystack: string }[] = [];
    let active = -1;
    let current: typeof tags = [];

    const load = async () => {
      const response = await fetch('/search.json');
      entries = (await response.json()) as SearchEntry[];
      const counts = new Map<string, { id: string; label: string; count: number }>();
      for (const entry of entries) {
        for (const tag of entry.tags) {
          const found = counts.get(tag.id) ?? { id: tag.id, label: tag.label, count: 0 };
          found.count += 1;
          counts.set(tag.id, found);
        }
      }
      tags = [...counts.values()]
        .map((tag) => ({ ...tag, haystack: normalize(tag.label) }))
        .sort((left, right) => right.count - left.count || left.label.localeCompare(right.label, 'pl'));
      ready = true;
      render();
    };

    const closeSuggestions = () => {
      suggestions.hidden = true;
      suggestions.innerHTML = '';
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      active = -1;
      current = [];
    };

    const pick = (index: number) => {
      const chosen = current[index];
      if (!chosen) return;
      input.value = chosen.label;
      closeSuggestions();
      render();
      input.focus();
    };

    const renderSuggestions = () => {
      const query = normalize(input.value);
      if (query.length < 2) {
        closeSuggestions();
        return;
      }
      current = tags.filter((tag) => tag.haystack.includes(query)).slice(0, 8);
      if (current.length === 0) {
        closeSuggestions();
        return;
      }
      suggestions.innerHTML = '';
      current.forEach((tag, index) => {
        const item = document.createElement('li');
        item.id = `search-suggestion-${index}`;
        item.setAttribute('role', 'option');
        item.dataset.index = String(index);
        item.innerHTML = `<span>${tag.label}</span><span class="search__count">${tag.count}</span>`;
        item.addEventListener('mousedown', (event) => {
          event.preventDefault();
          pick(index);
        });
        suggestions.append(item);
      });
      active = -1;
      suggestions.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    const highlight = () => {
      for (const item of suggestions.children) {
        const index = Number((item as HTMLElement).dataset.index);
        item.classList.toggle('is-active', index === active);
        item.setAttribute('aria-selected', index === active ? 'true' : 'false');
      }
      if (active >= 0) input.setAttribute('aria-activedescendant', `search-suggestion-${active}`);
      else input.removeAttribute('aria-activedescendant');
    };

    input.addEventListener('input', () => {
      renderSuggestions();
      render();
    });

    input.addEventListener('keydown', (event) => {
      if (suggestions.hidden) return;
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        active = (active + 1) % current.length;
        highlight();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        active = active <= 0 ? current.length - 1 : active - 1;
        highlight();
      } else if (event.key === 'Enter') {
        event.preventDefault();
        if (active >= 0) pick(active);
      } else if (event.key === 'Escape') {
        closeSuggestions();
      }
    });

    input.addEventListener('blur', () => window.setTimeout(closeSuggestions, 100));

    const formatDate = (iso: string) =>
      new Date(`${iso}T00:00:00Z`).toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });

    const render = () => {
      const query = input.value.trim();
      list.innerHTML = '';
      if (query.length < 2) {
        status.textContent = ready ? `${entries.length} odcinków w indeksie` : 'Wczytuję indeks…';
        return;
      }
      const found = entries
        .map((entry) => ({ entry, result: matches(entry, query) }))
        .filter(({ result }) => result.hit);
      status.textContent = found.length === 0 ? 'Brak wyników' : `${found.length} ${found.length === 1 ? 'odcinek' : 'odcinków'}`;

      for (const { entry, result } of found) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `/odcinki/${entry.slug}/`;
        const time = document.createElement('time');
        time.dateTime = entry.date;
        time.textContent = formatDate(entry.date);
        const title = document.createElement('span');
        title.textContent = entry.title;
        link.append(time, title);
        item.append(link);
        if (result.tags.length > 0) {
          const tags = document.createElement('p');
          tags.className = 'search__tags';
          tags.textContent = result.tags.slice(0, 6).map((tag) => tag.label).join(' · ');
          item.append(tags);
        }
        list.append(item);
      }
    };

    input.addEventListener('input', render);
    load().catch(() => {
      status.textContent = 'Nie udało się wczytać indeksu.';
    });

    const params = new URLSearchParams(location.search);
    const initial = params.get('q');
    if (initial) input.value = initial;
    render();
  }
</script>
