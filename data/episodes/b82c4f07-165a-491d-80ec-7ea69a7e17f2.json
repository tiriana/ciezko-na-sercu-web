  "quotes": [
    {
      "start": 258.41,
      "text": "Czego więcej można chcieć od życia? Sięgnąłem po Rick of Patrifaction, klasyk grindu z repertuaru Carcass"
    },
    {
      "start": 318.27,
      "text": "Blinded za chwilę posłuchamy, bo ich płyta Deuterium"
    },
    {
      "start": 778.21,
      "text": "Terror Dome"
    },
    {
      "start": 1077.52,
      "text": "For God Your Soul"
    },
    {
      "start": 1865.71,
      "text": "Warning"
    },
    {
      "start": 3008.09,
      "text": "Obok Slipknot, oczywiście fani Deftons nawet nie dzwonią ze skargami"
    },
    {
      "start": 3008.09,
      "text": "System of a Down powracają do Polski jako megagwiazdy"
    },
    {
      "start": 3835.19,
      "text": "Nie byłoby Biohazard, niczego by nie było, gdyby nie Chromax"
    },
    {
      "start": 3835.19,
      "text": "Biohazard, główne gwiazdy wieczorów, trzech, to mistrzowie Muscle Cora, Rap Cora, Metal Cora z Nowego Jorku"
    },
    {
      "start": 4404.88,
      "text": "Generis"
    },
    {
      "start": 7128.62,
      "text": "Ja jednak tego samego dnia, ostatniego dnia lipca zostęp w Krakowie, bo w Hype Parku do tańca zmuszą mnie Amerykanie z Municipal Waste."
    }
  ],
