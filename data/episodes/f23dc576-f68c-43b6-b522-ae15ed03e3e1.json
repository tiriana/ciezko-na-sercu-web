  "quotes": [
    {
      "start": 120,
      "text": "Głosami publiczności po fantastycznym, bardzo profesjonalnym, bardzo brutalnym, kipiącym energią występie przeszedł zespół Unblessed Divine"
    },
    {
      "start": 533,
      "text": "Ja już ich znałem wcześniej z płyty ubiegłorocznej Eco Mora"
    },
    {
      "start": 929,
      "text": "Xifisurg wydał niedawno pełnoczasowy album 1096 i z niego utwór za chwilę usłyszymy"
    },
    {
      "start": 1342,
      "text": "Już kiedyś tu prezentowałem fragment ich epki, Cycle of Violence i dobre to było"
    },
    {
      "start": 1628,
      "text": "którego zapowiedzią jest singiel Wejdź w moje bramy i za chwilę go wysłuchamy"
    },
    {
      "start": 4644,
      "text": "W 2024 roku zespół wydał debiutancki album zatytułowany Frozen Nightmares nakładem wytwórni Antena Krzyku. Obecnie grupa pracuje nad drugim dużym materiałem..."
    },
    {
      "start": 7204,
      "text": "Doskonałe, prawda? Nazywają się Torsje i koniecznie trzeba o nich pamiętać."
    }
  ],
