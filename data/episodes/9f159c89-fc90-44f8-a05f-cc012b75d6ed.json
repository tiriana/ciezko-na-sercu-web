  "quotes": [
    {
      "start": 277,
      "text": "Tego samego dnia zresztą ukazał się pierwszy oficjalny singiel Mur, czyli Heimslit."
    },
    {
      "start": 1417,
      "text": "Wybrałem utwór zatytułowany Abyss Gaze is Back."
    },
    {
      "start": 2178,
      "text": "Utwór Jestem pochodzi z nowej płyty warszawskiego zespołu Czerń, która ukazała się na początku września i nosi tytuł Klątwa."
    },
    {
      "start": 2420,
      "text": "Mama Likes, The Door Closed. To utwór, który wybrałem dla Państwa z płyty Never Neverland, trzeciej w dorobku Unto Others."
    },
    {
      "start": 2550,
      "text": "Debiutancki album grupy nosi tytuł Hex i słuchamy utworu tytułowego."
    },
    {
      "start": 2976,
      "text": "The Jesus Lizard może nie są młodzi, ale nigdy, przenigdy się nie zestarzeją."
    },
    {
      "start": 3270,
      "text": "A Dorior to ciekawy przypadek. Muzycy, którzy chcą w trzeciej dekadzie grać ekstremalny metal..."
    },
    {
      "start": 3680,
      "text": "Die Urkatastrophe, czyli pierwotna katastrofa, to tytuł nowego albumu Kanonen Fieber"
    },
    {
      "start": 4470,
      "text": "możemy się przekonać słuchając drugiej płyty APEP zatytułowanej Before Whom Evil Trumbles"
    },
    {
      "start": 5110,
      "text": "Ripped to Shreds jest zespołem z Kalifornii, za którym stoi niejaki Andrew Lee"
    },
    {
      "start": 6913,
      "text": "nowy album to Międzyczasa"
    }
  ],
