  "quotes": [
    {
      "start": 332.24,
      "text": "Tak twierdzi wujek Kwas w refrenie wysłuchanej przez nas przed chwilą piosenki Shapes of Midnight"
    },
    {
      "start": 786.19,
      "text": "GammaSide wydali tylko jeden album w niesławnej wytwórni Wild Rex"
    },
    {
      "start": 2793.58,
      "text": "Kto słucha ciężko na sercu regularnie, doskonale wie, że bardzo lubię Chat Pile"
    },
    {
      "start": 2843.46,
      "text": "Chat Pile na swojej nowej płycie opisują to, czego wszyscy na co dzień doświadczamy"
    },
    {
      "start": 3452.07,
      "text": "Jej szósta płyta zatytułowana This Killing Times, też bardzo metalowy tytuł"
    },
    {
      "start": 3871.1,
      "text": "finał albumu to 16‑minutowa suita do nagrania, której Green Carnation zaangażowali orkiestrę symfoniczną i chór operowy"
    },
    {
      "start": 4310.09,
      "text": "Obscured Horizons jest ósmą już płytą w dyskografii The Eternal"
    },
    {
      "start": 4589.45,
      "text": "Archgoat od prawie 40 lat grają muzykę brutalną... na nowej płycie Nightbringer, Lightbringer"
    },
    {
      "start": 5068.35,
      "text": "utworu zupełnie nowego teraz posłuchamy, nosi tytuł Eye Sculpture i dał tytuł całemu wydawnictwu"
    },
    {
      "start": 5403.58,
      "text": "Album zatytułowany We Against Us Prologue to na pewno top polskich tegorocznych ciężarów."
    },
    {
      "start": 5642.03,
      "text": "trio Gottslat, dowodzone przez gitarzystę i wokalistę Krzyśka Śniadeckiego, trio, które wydało właśnie swoją drugą płytę, The Art of Deconstruction."
    },
    {
      "start": 5935.36,
      "text": "Zespół pionierski, zawsze bezkompromisowy. Nie inaczej jest i tym razem na Decay, który być może jest najlepszą płytą Godflesh po ich powrocie na scenę ponad 15 lat temu."
    },
    {
      "start": 6192.77,
      "text": "Niemiecki The Ocean zmagał się ostatnio ze zmianami składu, które prawie zakończyły ich działalność, ale właśnie prawie, nie definitywnie. Wracają w pełni sił świetną płytą Solaris."
    }
  ],
