  "quotes": [
    {
      "start": 811.14,
      "text": "Tak jest jedna literka F jak Franciszek, a płyta, z której pochodzi to nagranie nosi tytuł 1-3"
    },
    {
      "start": 873.99,
      "text": "Za takowych też chyba można uznać angielski zespół Thine, który w połowie lat dziewięćdziesiątych podpisał kontrakt z wytwórnią Peaceville"
    },
    {
      "start": 1694.11,
      "text": "Ale już druga płyta, zdecydowanie mniej romantyczna, za to bardziej progresywna, zatytułowana Today Died Yesterday"
    },
    {
      "start": 2256.81,
      "text": "Posłuchajcie tylko piosenki zatytułowanej Pure Inspiration"
    },
    {
      "start": 2598.03,
      "text": "geomungo, które ma struny, więc w sumie nadaje się do ciężkiej muzyki"
    },
    {
      "start": 2948.22,
      "text": "zostawili nam album Love's Holiday, który brzmi mniej więcej tak"
    },
    {
      "start": 3591.75,
      "text": "Meditation is the Practice of Death, czyli Medytacja jest ćwiczeniem śmierci"
    },
    {
      "start": 4395.9,
      "text": "Co udowodnie za chwilę puszczając dwa numery z albumu A Greater Darkness z 2007 roku"
    },
    {
      "start": 5525.3,
      "text": "Póki co słuchamy utworu Antioxidant ze wspomnianej przed chwilą ostatniej płyty nowo-orlańskiej grupy"
    },
    {
      "start": 6247.64,
      "text": "wybrzmi adekwatnie zatytułowana piosenka Dead, zespołu o egzotycznej nazwie Canate"
    },
    {
      "start": 6375.35,
      "text": "Rzecz pochodzi z albumu Things Viral, wydanego w 2003 roku"
    }
  ],
