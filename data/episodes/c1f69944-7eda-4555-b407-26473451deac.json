  "quotes": [
    {
      "start": 366,
      "text": "Dobry wieczór Państwu. Przywitała Was Zorza piosenką My Wounds, w której gościnnie udziela się Pan z Harakiri From the Sky."
    },
    {
      "start": 456,
      "text": "pojawi się jeden z najlepszych thrash metalowych zespołów zrodzonych w XXI wieku, czyli amerykański Havok."
    },
    {
      "start": 1567,
      "text": "deadline rusza w trasę o nazwie The Dine Fall Tour, a jeździł będzie z zespołami Imperial Scene oraz Black Star Mantra."
    },
    {
      "start": 1626,
      "text": "przede wszystkim The Ruins of Beverast, których specjalizacja to unurzany w blackowej siarce doom,"
    },
    {
      "start": 2092,
      "text": "oraz holenderskie black metalowe wiedźmy z Asagraum."
    },
    {
      "start": 2504,
      "text": "supportujący ich brytyjski Conjurer"
    },
    {
      "start": 3002,
      "text": "Sick Saints i Hypnozaur nazwali wspólną trasę After Glam Tour"
    },
    {
      "start": 3695,
      "text": "Dehu już na koń siedli, szabli dobyli i pędzą ku Europie przez swoje mongolskie stepy"
    },
    {
      "start": 3695,
      "text": "przy muzyce Dehu oraz francuskiego Scald zabawimy się w stolicy, w klubie Stodoła"
    },
    {
      "start": 4530,
      "text": "Właśnie ukazała się ich nowa płyta Come This Madness"
    },
    {
      "start": 5040,
      "text": "Co innego norweska Gehenna, którą zobaczymy też tego wieczoru"
    },
    {
      "start": 5273,
      "text": "Dark Funeral niedawno wydał koncertowy album A Beast to Praise Live in Stockholm"
    },
    {
      "start": 5908,
      "text": "Amon Amarth zagrają 29 października w Prezero Arenie Gliwice"
    },
    {
      "start": 6862,
      "text": "Ładnie się składa, że mogę dzisiaj Państwa pożegnać piosenką Boris, która, a jakże, nosi tytuł Pożegnanie i o czym fani Japończyków doskonale wiedzą, jest powitaniem na ich kultowej płycie Pink."
    }
  ],
