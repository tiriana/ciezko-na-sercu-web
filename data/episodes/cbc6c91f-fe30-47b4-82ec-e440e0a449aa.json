  "quotes": [
    {
      "start": 1134,
      "text": "Posłuchamy fragmentu płyty The Essence Has Changed But The Details Remained."
    },
    {
      "start": 1824,
      "text": "Słuchamy utworu No Heart z wydanego w 2018 roku mini albumu Magna Minus."
    },
    {
      "start": 2280,
      "text": "Wydana w styczniu 2021 roku płyta o VV"
    },
    {
      "start": 2628,
      "text": "Z płyty Ufonaut wybrałem dla Państwa utwór Samsara."
    },
    {
      "start": 3084,
      "text": "Weźmy choćby płytę Enemy of Man sprzed dokładnie dekady."
    },
    {
      "start": 3564,
      "text": "Słuchamy utworu Prefatio Pro Defunctis z płyty Anssia."
    },
    {
      "start": 4320,
      "text": "choćby album zatytułowany jest Dziewięć kluczy do Królestwa Cieni, wydawnictwo sprzed trzech lat."
    },
    {
      "start": 4686,
      "text": "Pod tym szyldem dwie płyty nagrał Stanisław Wołonciej z Bielska Białej"
    },
    {
      "start": 6959,
      "text": "Płyta Thanatos, która właśnie teraz ma premierę, uroczo cuchnie siarką. Pewnie w tym winie z tytułu utworu When the Creation Tastes of Dionysian Wine też jest sama siarka."
    }
