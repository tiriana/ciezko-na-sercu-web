  "quotes": [
    {
      "start": 304.3,
      "text": "Płyta wspomnianego już Besfary Jelsen, zatytułowana Till Glomskan Ad Oblivionem, wychodzi 28 lipca."
    },
    {
      "start": 375.14,
      "text": "Dziesiąty album tego amerykańskiego zespołu wychodzi 31 lipca i nosi tytuł Legacy."
    },
    {
      "start": 608.6,
      "text": "Devil Driver ... 10 lipca ukazał się już 11. album grupy zatytułowany Strike and Kill."
    },
    {
      "start": 902.92,
      "text": "Future Palace ... 31 lipca wydaje w Century Media swoją czwartą płytę zatytułowaną Resurgence."
    },
    {
      "start": 1147.36,
      "text": "Moonspell ... na początku miesiąca świętował premierę nowego albumu zatytułowanego Far From God."
    },
    {
      "start": 1586.35,
      "text": "płyta, z której pochodzi, nosi tytuł The Back of Beyond i ukaże się lada moment, bo ostatniego dnia lipca."
    },
    {
      "start": 2065.25,
      "text": "Zespół ... przypomniał o sobie płytą The Hidden Hand, wydaną przez Metal Blade."
    },
    {
      "start": 2494.27,
      "text": "Haken, która w lipcu wydała epkę In A Fevered Dream."
    },
    {
      "start": 2783.6,
      "text": "Old szukają nowych rozwiązań ... ich nowa druga płyta zatytułowana Ataraxia to rzecz bardzo udana."
    },
    {
      "start": 3082.91,
      "text": "Święta prawda, teraz też będzie brutalnie. No Cure."
    },
    {
      "start": 3807.25,
      "text": "Nową trzecią płytę wydał w tym miesiącu mongolski zespół The Who."
    },
    {
      "start": 3836.18,
      "text": "Tego, co znamy przede wszystkim z poprzedniej płyty, czyli Rumble of Thunder"
    },
    {
      "start": 4240.25,
      "text": "utworem Spirit Helper"
    },
    {
      "start": 4439.8,
      "text": "siódmy album zatytułowany Nowhere's Picks ukazał się niedawno nakładem francuskiej wytwórni Season of Mist"
    },
    {
      "start": 4906.72,
      "text": "deb iutancki album Left to Die, zatytułowanie Initium Mortis"
    },
    {
      "start": 5183.09,
      "text": "Psychroptic zadebiutował właśnie w barwach Metal Blade, albumem The Pulse of Annihilation, który jest, jeśli dobrze liczę, dziewiątą płytą w ich dorobku."
    },
    {
      "start": 5423.54,
      "text": "to już ich druga płyta ze śnieżnym death metalem, a nosi tytuł Snowbound Horror."
    },
    {
      "start": 5721.85,
      "text": "Desolate Echoes of Turmoil. To trzeci album Norwegów z Profane Burial i gdyby go wydali pod koniec ubiegłego stulecia, dzisiaj cieszyliby się statusem zespołu kultowego."
    },
    {
      "start": 6694.61,
      "text": "Do snu ukołysze nas dziś amerykański Soas, utworem ze swojej piątej płyty Fading Failing Ruin."
    }
  ],
