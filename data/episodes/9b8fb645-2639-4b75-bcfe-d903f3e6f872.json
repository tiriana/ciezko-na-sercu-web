  "quotes": [
    {
      "start": 562,
      "text": "Ta piękna, niespiesznie rozwijająca się piosenka to Cypher z repertuaru angielskiej grupy Esoteric"
    },
    {
      "start": 1154,
      "text": "Band by the Sun pochodzili z New Jersey, byli aktywni przez pierwszą dekadę XXI wieku i grali w ściekłą mieszankę death metalu"
    },
    {
      "start": 1174,
      "text": "na drugiej płycie zatytułowanej The Perfect is the Enemy of the Good"
    },
    {
      "start": 1644,
      "text": "Tuż przed rozpadem Kanadyjczycy wydali świetny trzeci album, Elementary"
    },
    {
      "start": 2355,
      "text": "Posłuchamy utworu Translucide z płyty Le Grand Buffet z 2012 roku"
    },
    {
      "start": 3132,
      "text": "Wysłuchaliśmy piosenki, tak, jednej piosenki, to nie były dwa różne utwory grupy Chromchów o tym, że śmierć jest pewniakiem"
    },
    {
      "start": 3421,
      "text": "I bardzo dobrze zrobili, czego dowodem będzie piosenka właśnie z tamtego materiału zatytułowana I Saw Close"
    }
  ],
