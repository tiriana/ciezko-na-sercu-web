  "quotes": [
    {
      "start": 245,
      "text": "Zaczęliśmy od Amon Amarth, którzy na albumie The All Father Awakens proponują więcej tego samego"
    },
    {
      "start": 315,
      "text": "Przyszła się pożegnać albumem Hate to Go, Take Out or Delivery"
    },
    {
      "start": 667,
      "text": "Skromną próbkę usłyszycie za chwilę, a ja dodam tylko, że materiał produkował niejaki Spad Murphy"
    },
    {
      "start": 1190,
      "text": "Utwór nosi tytuł Mantras of Delusion, czyli Mantry Złudzeń"
    },
    {
      "start": 1500,
      "text": "Nowy album Ksastur nosi przepiękny tytuł"
    },
    {
      "start": 2150,
      "text": "Fever, ich siódma płyta, to potwierdza"
    },
    {
      "start": 3301,
      "text": "Płyta zatytułowana po prostu Forbidden, która ukazuje się 23 października"
    },
    {
      "start": 3600,
      "text": "dziesiątej już płycie grupy zatytułowanej Netherworlds"
    },
    {
      "start": 3992,
      "text": "Wybrałem dla Państwa utwór Devil May Try"
    },
    {
      "start": 4320,
      "text": "Nowa płyta Mental Cruelty nosi tytuł Echoes of a Forlorn Land"
    },
    {
      "start": 5700,
      "text": "płyta Mead, którą Norwedzy wydają ostatniego dnia października"
    },
    {
      "start": 6024,
      "text": "Amerykański zespół black metalowy Spirit Possession wydał nową płytę zatytułowaną Cathedral Speech."
    },
    {
      "start": 6511,
      "text": "Wolves in the Throne Room wydają w tym miesiącu nowy album zatytułowany Estuary i że znajdziecie na nim sześć świetnych utworów."
    }
  ],
