  "quotes": [
    {
      "start": 756,
      "text": "To była nekromantia ze swojej pierwszej dużej płyty Crossing the Fiery Path z 1993 roku"
    },
    {
      "start": 1124,
      "text": "To był Varatron z mini-albumu The Lament of Gods, wydanego przez naszą polską firmę Pagan Records w 1999 roku"
    },
    {
      "start": 1516,
      "text": "Za nami Rotting Christ z albumu Sleep of the Angels, ostatniego wydanego w ubiegłym stuleciu"
    },
    {
      "start": 1926,
      "text": "Debiutancki album Tabakisa, wydany wiosną tego roku, nosi tytuł Paradise Metal"
    },
    {
      "start": 2312,
      "text": "Tymczasem proponuje powrót do drugiej płyty grupy, czyli My, Oświeceni z dziewięćdziesiątego ósmego roku."
    },
    {
      "start": 2995,
      "text": "najnowszą sprzed roku, czyli Children of Eve."
    },
    {
      "start": 2999,
      "text": "On Torns I Lay, to również zespół, którego karierę liczymy już w dekadach"
    },
    {
      "start": 3375,
      "text": "Na perkusji natomiast Hexbane gra, uwaga, Faust, czyli Norweg, z pierwszego składu Emperora"
    },
    {
      "start": 5646,
      "text": "Virgin Steel jest zespołem, który niezmiennie cenię za muzykę"
    },
    {
      "start": 6584,
      "text": "Imperius pożegna was utworem Skorn, który jest o upokorzeniu, które musiał przełknąć Odyseusz"
    }
  ],
