  "quotes": [
    {
      "start": 256,
      "text": "Deep Purple, proszę Państwa, powitali Was tytułowym utworem z albumu Perfect Strangers."
    },
    {
      "start": 780,
      "text": "20 marca tego roku, bez żadnych zapowiedzi i przecieków, ... dwunasta płyta studyjna Neurosis, czyli niewyczerpana miłość do płonącego świata."
    },
    {
      "start": 809,
      "text": "Szwajcarski zespół Celtic Frost, którego przed chwilą wysłuchaliśmy, milczał przez 16 lat... płyta Monotheist."
    },
    {
      "start": 2350,
      "text": "W 2025 roku, a więc po 34 latach milczenia, Dark Angel wydali album Extinction Level Event."
    },
    {
      "start": 2737,
      "text": "W 2004 roku, kiedy ukazała się płyta The Art of Dying."
    },
    {
      "start": 3546,
      "text": "Już sam fakt, że Jeff Beckera, wokalista zespołu, wrócił na scenę po tym, jak prawie zginął od kul, zasługuje na wielki szacunek."
    },
    {
      "start": 3589,
      "text": "w 2019 roku, po ponad trzydziestu latach, Possessed wydało płytę z nowym materiałem zatytułowaną Revelations of Oblivion."
    },
    {
      "start": 3849,
      "text": "Płyta nosi tytuł Lords of the Permafrost i wyszła w 2019 roku."
    },
    {
      "start": 4216,
      "text": "Album Surgical Steel z 2013 roku brzmi dokładnie tak, jak się nazywa."
    },
    {
      "start": 5810,
      "text": "albumem The Ghost of a Future Dead at the Gates pożegnali się z nami już na zawsze."
    },
    {
      "start": 6215,
      "text": "album Black Gives Way to Blue z 2009 roku, a więc wydany 14 lat po poprzednim"
    },
    {
      "start": 6424,
      "text": "Czy wydana w 2013 roku, po 18 latach wydawniczej ciszy, płyta 13 należy do najlepszych albumów Black Sabbath?"
    }
  ],
