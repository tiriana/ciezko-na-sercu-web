  "quotes": [
    {
      "start": 265,
      "text": "Chelsea Wolfe zapewniła nas piosenką, że śmierć to nie koniec."
    },
    {
      "start": 593,
      "text": "Utwór Front Toward Enemy pochodzi z nowej płyty Mansona zatytułowanej One Assassination Under God Chapter Two"
    },
    {
      "start": 754,
      "text": "Mam za to przed sobą nową płytę Electric Cowboy, zatytułowaną Tant Night"
    },
    {
      "start": 1245,
      "text": "Snakes for Dinner, węże na obiad. To tytuł utworu, który zaprezentuje nam dzisiaj zespół Mastodon, utworu reprezentującego ich nowy album Marrow Deep"
    },
    {
      "start": 1858,
      "text": "La Drones to Meksykanie, którzy próbują łączyć new metal, a nawet rap metal... warto zaprezentować płytę Arriba La La"
    },
    {
      "start": 2119,
      "text": "Muszę przyznać, że jestem pozytywnie zaskoczony płytą IDOS litewskiej grupy Black Spikes"
    },
    {
      "start": 5725,
      "text": "Nie będziemy dziś jednak słuchać Mannes, lecz nowego projektu Skei, który nosi nazwę Holistik"
    },
    {
      "start": 6181,
      "text": "Z płytą Chapter One, This Endless Solitude zmierzyć się więc warto"
    },
    {
      "start": 6621,
      "text": "Wyraj to nowy album zespołu Dymna Lotwa"
    },
    {
      "start": 6873,
      "text": "posłuchamy fragmentu ich dziewiątej, płyty dla niepoznaki zatytułowanej Nine"
    }
  ],
