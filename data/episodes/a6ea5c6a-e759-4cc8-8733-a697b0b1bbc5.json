  "quotes": [
    {
      "start": 637,
      "text": "a w 2022 roku debiutancki album Doomsday"
    },
    {
      "start": 1168,
      "text": "Więc posłuchamy teraz utworu z piątej już płyty zespołu z Jaworzna, zatytułowanej Contemporary Guide to Modern Living."
    },
    {
      "start": 1537,
      "text": "Utwór, którego wysłuchamy za chwilę nosi tytuł Psychosis 448"
    },
    {
      "start": 2064,
      "text": "W lutym wyszła epka SOMA zatytułowana Locker Room, której fragmentów za chwilę posłuchamy."
    },
    {
      "start": 2832,
      "text": "Romantyczny Wieczór to nazwa zespołu, a tytuł utworu, którego przed chwilą wysłuchaliśmy, brzmi Dancing w Goczałkowicach."
    },
    {
      "start": 2874,
      "text": "A zatem posłuchajmy jeszcze jednej piosenki z mini albumu zatytułowanego Sympatyczne melodie. Jej tytuł to Zapach babcinego ciasta."
    },
    {
      "start": 3036,
      "text": "Posłuchamy Burzy, a ja przy okazji zaznaczę, że to jest utwór ze wspomnianej soli"
    },
    {
      "start": 3388,
      "text": "A czy im się to założenie udało zrealizować możemy sprawdzić na epce z 2023 roku zatytułowanej Auruk."
    },
    {
      "start": 3717,
      "text": "Debiutancki album Toughness nosi tytuł The Prophetic Dawn, został wydany we wrześniu 2022 roku"
    },
    {
      "start": 4332,
      "text": "Wysłuchaliśmy piosenki, która nosi tytuł Cult of Depression i znajdzie się na nowej płycie grupy Obsidian Mantra."
    },
    {
      "start": 4445,
      "text": "Jeszcze jedna więc dzisiaj zapowiedź płyty Obsidian Mantra, piosenka zatytułowana Who Will Become a Murderer?"
    },
    {
      "start": 4708,
      "text": "Bominated pochodzą z Warszawy i rok temu mniej więcej wydali debiutancki album Traumatic Potrafaction"
    },
    {
      "start": 5408,
      "text": "Nazywają się Sewer Dwellers i grają deathcora ..."
    }
  ],
