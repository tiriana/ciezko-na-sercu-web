  "quotes": [
    {
      "start": 399,
      "text": "Wysłuchaliście Państwo przed chwilą utworu Kronas z płyty False Light ukraińskiej grupy White World"
    },
    {
      "start": 547,
      "text": "To był amerykański zespół Noru. Dali fantastyczny koncert na tegorocznym Roadburn w sobotę o godzinie 13"
    },
    {
      "start": 848,
      "text": "To Chelsea Wolfe dała świetny koncert w Tilburgu"
    },
    {
      "start": 961,
      "text": "Hex Vessel, do których jeszcze wrócimy w innej audycji, bo szykuje się dłuższa rozmowa z liderem grupy"
    },
    {
      "start": 1506,
      "text": "Debiutancka, solowa płyta Lorda Spike Hartha nosi tytuł The Adept i pełna jest gości"
    },
    {
      "start": 1774,
      "text": "Posłuchamy jeszcze jednego utworu z nowego albumu Lorda Spike Hartha Acts of God"
    },
    {
      "start": 2050,
      "text": "Słuchamy zatem Coach Slot utworu Downhill Racer"
    },
    {
      "start": 2463,
      "text": "Utwór Flash Market ze wspomnianej tu najnowszej płyty Atro City Machine"
    },
    {
      "start": 2918,
      "text": "na poprzedzającej album Atro City Machine Epce znalazł się fantastyczny utwór Burn"
    },
    {
      "start": 4705,
      "text": "Blood Incantation zatem, posłuchajmy."
    },
    {
      "start": 5193,
      "text": "A ja dzisiaj prezentuję piosenki z wydanej w 1989 roku płyty Total Doom."
    },
    {
      "start": 6540,
      "text": "Przykładem mogą być tegoroczne koncerty Backwash czy Clipping."
    }
  ],
