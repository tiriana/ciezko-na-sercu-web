  "quotes": [
    {
      "start": 410.06,
      "text": "W ramach promocji swojej nowej płyty Goh K, której premiera już za chwilę, Psyche zagrają 4 września w Krakowie w klubie Zaścianek."
    },
    {
      "start": 574.68,
      "text": "To był Devil Master i Sex with Sukubus."
    },
    {
      "start": 1108.45,
      "text": "I właśnie Gesu posłuchamy teraz, bo to piękne i dobre."
    },
    {
      "start": 1696.1,
      "text": "Będzie Arabrot, czyli norweski zespół rockowy, jedyny w swoim rodzaju."
    },
    {
      "start": 2838.48,
      "text": "Skład w garaż pubie 11 i 12 września udało mu się zebrać zacny, bo to m.in. Squash Bowels FAM,"
    },
    {
      "start": 2928.27,
      "text": "honoru Polski i Kosmosu bronić będzie fantastyczny i niestety ciągle niedoceniany zespół Planet Hell."
    },
    {
      "start": 3264.5,
      "text": "W tym roku na scenie Thunderfest znajdzie się miejsce dla Samaela, The Crown, Christ's Agony, The Black Thunder, Eiffel, 1710, Toughness, Clairvoyance i Wielkiego Mroku."
    },
    {
      "start": 3902.03,
      "text": "Die Disease na swojej ubiegłorocznej płycie United with Fall przeżywali drugą nieoczekiwanie brutalną młodość, co zaświadczy za chwilę piosenka Hollow Future."
    },
    {
      "start": 4953.62,
      "text": "Z Wielkiej Brytanii przybędzie trashowy zespół Ominus Moon."
    },
    {
      "start": 5327.76,
      "text": "Grają melodyjny, techniczny, progresywny death metal. Grają go w Colorado."
    },
    {
      "start": 5937.35,
      "text": "polecam koncert, na którym wystąpi indonezyjska grupa Senyawa"
    },
    {
      "start": 6031.14,
      "text": "Gwiazdą wieczoru będzie Spirit Box, którego progresywna wizja metalcora zaprowadziła ich już nawet na galę nagród Grammy."
    }
  ],
