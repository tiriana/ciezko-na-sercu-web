  "quotes": [
    {
      "start": 220.49,
      "text": "powitał Was estoński zespół Evestus, piosenką To Hell and Back"
    },
    {
      "start": 220.49,
      "text": "Agresor numeru tytułowego z debiutu, czyli Procreate Petrifications"
    },
    {
      "start": 1452.66,
      "text": "ich nowa epka nosi tytuł This War Left You Nothing"
    },
    {
      "start": 1903.62,
      "text": "zaprezentuję wam fragment albumu Parasit"
    },
    {
      "start": 2610,
      "text": "zespół Humanity ze swojej debiutanckiej płyty Out of Structure wydanej w czerwcu ubiegłego roku"
    },
    {
      "start": 3659.59,
      "text": "Sergent to kwartet z Talina, wykonujący progresywny death metal."
    },
    {
      "start": 3701.49,
      "text": "Utór z płyty słuchaliśmy przed chwilą, a teraz wspomniane Oczy Demona."
    },
    {
      "start": 3920.99,
      "text": "Muzyka Intrepid to death metal, nie całkiem staroszkolny, ale też nieprogresywny w takim sensie"
    },
    {
      "start": 4250.23,
      "text": "Słuchamy piosenek Intrepid z epki Slain of Sanity, Murder of Mind z 2023 roku."
    },
    {
      "start": 4555.53,
      "text": "Zadebiutowali w 2021 roku, ale ja was tutaj częstuję utworami z płyty Vagabond wydanej jesienią ubiegłego roku."
    },
    {
      "start": 5297.82,
      "text": "Słuchamy utworu Diamonds z płyty Dimension z 2021 roku."
    },
    {
      "start": 5716.86,
      "text": "Posłuchajmy jeszcze jednego numeru Nihilisty Crypt singla z 2024 roku zatytułowanego Lessons in Constraint."
    },
    {
      "start": 6609.81,
      "text": "posłuchamy jeszcze zespołu, który rozpoczął nam ten piękny dzisiejszy wieczór, zespołu Evestus"
    }
  ],
