  "quotes": [
    {
      "start": 271.38,
      "text": "Utwór, od którego dzisiaj zacząłem, nosi tytuł Duch i pochodzi z wydanej niedawno nowej płyty grupy Tenebris, zatytułowanej Kochanowski."
    },
    {
      "start": 680.44,
      "text": "Na swojej nowej płycie Ugory opowiadają nam o ludowym, wiejskim przeżywaniu śmierci i żałoby."
    },
    {
      "start": 1121.42,
      "text": "A ja już dziś mogę wam zaprezentować utwór tytułowy, który opowiada o życiu w depresji, rezygnacji, ciągłej walce..."
    },
    {
      "start": 2358.58,
      "text": "Asterie w utworze 148."
    },
    {
      "start": 2791.58,
      "text": "God of Fire to bardzo dobry numer, zawodowo zagrany i zaśpiewany, świetnie brzmiący."
    },
    {
      "start": 3586.76,
      "text": "Ich album, niedawno wydany, nosi tytuł Annika"
    },
    {
      "start": 3906.02,
      "text": "Ta jednak w styczniu właśnie na początku tego roku wyszła, nosi tytuł Fury Unleashed i przyniosła nam 12 porcji krwistego def metalowego mięsa"
    },
    {
      "start": 4256.22,
      "text": "za chwilę go usłyszycie, który nazywa się C-No"
    },
    {
      "start": 5963.29,
      "text": "Wśród inspiracji grupa wymienia m.in. takie nazwy jak Dead Can Dance"
    },
    {
      "start": 5990.23,
      "text": "Drowned in Silver ma trochę tego rytualnego, transowego aspektu, ale to jednak muzyka rockowa"
    },
    {
      "start": 6543.96,
      "text": "ich trzeci album, czyli właśnie Elegi, ukazał się niedawno w belgijskiej wytwórni Muse Music Records"
    }
  ],
