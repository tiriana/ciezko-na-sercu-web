  "quotes": [
    {
      "start": 302,
      "text": "powitał Was serdecznie amerykański zespół Morbid Angel, piosenką Chapel of Goals, pochodzącą z debiutu grupy albumu Altars of Madness"
    },
    {
      "start": 854,
      "text": "Gorefest to giganci deathmetallu z Niderlandów"
    },
    {
      "start": 1201,
      "text": "Najważniejszy niemiecki przedstawiciel pierwszej fali death metalu, czyli zespół Morgoth, też nie istnieje"
    },
    {
      "start": 1801,
      "text": "Ten nowojorski saksofonista, nie metalowiec bynajmniej, jest typem prymusa"
    },
    {
      "start": 1862,
      "text": "Naked City to, jak w przypadku większości projektów Johna Zorna, efemeryda, zespół, który istniał krótko, raptem kilka lat i nie istnieje już od 1993 roku"
    },
    {
      "start": 2730,
      "text": "Transcendence into the Peripheral z 1993 roku"
    },
    {
      "start": 3270,
      "text": "Kiedy słuchałem albumu Into Darkness, jedynej płyty Winter, wydanej w 1990 roku"
    },
    {
      "start": 5256,
      "text": "W 2005 Sentenced nagrali płytę zatytułowaną The Funeral Album"
    },
    {
      "start": 6124,
      "text": "Od wydania ostatniego póki co albumu grupy, czyli Of Lucifer and Lightning minęły prawie dwie dekady"
    },
    {
      "start": 6461,
      "text": "Ja uwielbiałem ich płytę z 98 roku zatytułowaną Completely Dehumanized"
    },
    {
      "start": 6701,
      "text": "666 to pierwszy z nich"
    }
  ],
