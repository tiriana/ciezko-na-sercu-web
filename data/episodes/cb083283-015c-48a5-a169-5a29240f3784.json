  "quotes": [
    {
      "start": 128,
      "text": "Kwartet Hypnozaur powitał nas piosenką ze swojej nowej, drugiej dużej płyty zatytułowanej Afterlife"
    },
    {
      "start": 258,
      "text": "Niedawno nagrali swoją pierwszą piosenkę po polsku i choć rozumiem tę decyzję"
    },
    {
      "start": 513,
      "text": "Album nosi tytuł Breathtaking, że niby zapiera dech w piersi"
    },
    {
      "start": 1260,
      "text": "Album nazywa się Shrines of Human Waste i jest to death metal równie techniczny, co intensywny"
    },
    {
      "start": 1505,
      "text": "Wokalistą zespołu Asperatus, którego przed chwilą wysłuchaliśmy, jest Łukasz Ciepała"
    },
    {
      "start": 1560,
      "text": "debiutancka, znowu debiutancka płyta Sable Oats to Infinity wydana została w maju przez oficynę Gods of War"
    },
    {
      "start": 1945,
      "text": "Znajdziecie na niej m.in. utwór Fight for All, dedykowany ukraińskim żołnierzom walczącym o wolność własnej ojczyzny"
    },
    {
      "start": 2280,
      "text": "Debiutancka płyta zespołu nosi tytuł Wrath Cult"
    },
    {
      "start": 3065,
      "text": "zespół Sarmat, który na początku roku wydał swoją drugą płytę The Ornaments of Disturbing Perspective"
    },
    {
      "start": 3115,
      "text": "Mieszka tam zespół Sarmat, który na początku roku wydał swoją drugą płytę The Ornaments of Disturbing Perspective i nie ma tutaj żartów."
    },
    {
      "start": 3594,
      "text": "Debiutancki album projektu Ageless Gateway nosi tytuł Corruptor of Stars. Ukazał się w kwietniu i zabiera nas w taką oto podróż."
    },
    {
      "start": 3997,
      "text": "Impure Declaration ... na swojej znowu pierwszej dużej płycie zatytułowanej Of Veins, Tendons and Bones."
    },
    {
      "start": 4400,
      "text": "Zespół Hexen Altar ... zasłużył na pełnowymiarowy debiut płytowy, który nosi tytuł Descending Curse."
    },
    {
      "start": 5110,
      "text": "Utwór nosi tytuł Śniący Zbudź się, chyba trudno lepszy, na zakończenie audycji o tej porze."
    }
  ],
