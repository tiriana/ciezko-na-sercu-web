  "quotes": [
    {
      "start": 381,
      "text": "przywitał Was estoński zespół Tarapita. Tytułowym utworem ze swojej nowej, tegorocznej płyty Oise Te Vaga Uhex"
    },
    {
      "start": 1150,
      "text": "To był zespół Sun Killer z tytułowym utworem z mini albumu Totality wydanym 1 października"
    },
    {
      "start": 1386,
      "text": "Diversion Ends jest jednym z nich i to też jest młody skład. Mają na koncie tylko epkę Divided, tegoroczną"
    },
    {
      "start": 1711,
      "text": "puszczę fragment ich tegorocznego albumu Secretly Dangerous"
    },
    {
      "start": 2497,
      "text": "A my posłuchamy, co dzieje się na ich tegorocznej epce zatytułowanej Control"
    },
    {
      "start": 3022,
      "text": "Najnowszy z nich to album Perpetual Cycles of Violence z marca tego roku"
    },
    {
      "start": 3203,
      "text": "taki projekt Fumantum to w ogóle nie jest metal, tylko dark ambient, drony i noise"
    },
    {
      "start": 3250,
      "text": "Wybrałem dla was utwór Unrest, co oznacza niepokój"
    },
    {
      "start": 3670,
      "text": "Pani nazywa się Laura Pritz i ma kawał głosu"
    },
    {
      "start": 4215,
      "text": "Ostatnim zespołem, który zaprezentował się na żywo 3 października w Talinie był Surogoat"
    },
    {
      "start": 4255,
      "text": "Nekro Leviathan"
    }
  ],
