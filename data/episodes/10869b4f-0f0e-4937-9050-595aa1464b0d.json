  "quotes": [
    {
      "start": 61,
      "text": "Po pierwsze lada moment ukazuje się jej nowa płyta, United Kingdom of Excity."
    },
    {
      "start": 122,
      "text": "Big Brave nagrali moim zdaniem jedną z najlepszych płyt tego roku, która nazywa się Chaos of Flowers"
    },
    {
      "start": 538,
      "text": "Immolation, czyli nowojorscy pionierzy death metalu... Najbliższa po temu okazja będzie już 9 października we wrocławskim A2."
    },
    {
      "start": 1499,
      "text": "A już dosłownie za chwilę ukaże się The Wolf and the King, czyli najnowszy album 1349"
    },
    {
      "start": 2629,
      "text": "Oto tytułowy utwór z tegorocznego albumu Inter Arma New Heaven"
    },
    {
      "start": 3100,
      "text": "W ubiegłym roku Tantifaxat wydali znakomitą płytę Hive Mind Narcosis i właśnie z niej posłuchamy piosenki o głodnych duchach"
    },
    {
      "start": 3509,
      "text": "Nowy album, a Peyron ukaże się lada moment i jeszcze na pewno wciężko na sercu do niego wrócę"
    },
    {
      "start": 4049,
      "text": "W tym roku Dot Street jeżdżą po świecie promując płytę Nocturnal Wheel, więc z tego właśnie albumu posłuchamy piosenki o ogniu, co płonie, o północy"
    },
    {
      "start": 4534,
      "text": "na ostatniej płycie, czyli Saturnian Bloodstorm, mniej już może wisielczej rozpaczy, a więcej gwałtowności, brutalności"
    },
    {
      "start": 5447,
      "text": "Włoska Mesa często u nas bywa i dobrze, że bywa, bo te koncerty są co najmniej interesujące."
    }
  ],
