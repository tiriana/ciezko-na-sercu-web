  "quotes": [
    {
      "start": 185.57,
      "text": "Zagrał dla nas Slayer, co jest znakiem niechybnym"
    },
    {
      "start": 2020.36,
      "text": "Pamiętam buńczuczne zapowiedzi płyty Come Before the Storm"
    },
    {
      "start": 2853.44,
      "text": "Czy największym rozczarowaniem w dyskografii Batory był oktagon"
    },
    {
      "start": 2858.43,
      "text": "Ja stawiam na Requiem nie dlatego, że to jednoznacznie zła płyta"
    },
    {
      "start": 3771.33,
      "text": "Płyta grupy, czyli Dark Side, wydana w 1997 roku"
    },
    {
      "start": 7219.41,
      "text": "Na koniec oczywiście Iron Maiden. Nie mogło ich zabraknąć"
    }
