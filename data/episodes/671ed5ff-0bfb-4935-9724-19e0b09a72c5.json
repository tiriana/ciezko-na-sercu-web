  "quotes": [
    {
      "start": 771,
      "text": "po wydaniu najnowszego albumu, czyli Vengeance of Eternal Fire, pięknie nam rosną i rozkwitają"
    },
    {
      "start": 1012,
      "text": "zakupioną po koncercie najnowszą płytą zespołu zatytułowaną Evenfall of the Apocalypse"
    },
    {
      "start": 2534,
      "text": "a zatem wspomniana już piosenka Death Metal Forever z albumu Live in Poland."
    },
    {
      "start": 3540,
      "text": "Ale na finał wybrzmiała ta piosenka, opowieść o tym, że, tu cytuję tytuł, zwycięstwo ma tysiąc ojców"
    },
    {
      "start": 3995,
      "text": "Overkill to jest ten zespół, którego dwudziesta płyta, czyli Scorched, ukazała się w ubiegłym roku"
    },
    {
      "start": 4334,
      "text": "Ich najnowsza płyta nosi świetny tytuł Lux, czyli Światło."
    },
    {
      "start": 5473,
      "text": "I tam rzeczywiście to, co zrobili headlinerzy przede wszystkim, czyli Mayhem ze swoim setem na 40-lecie, niesamowitym setem."
    },
    {
      "start": 5521,
      "text": "Bardzo się cieszę, że udało się pierwszy raz zorganizować koncert The Crown z Szwecji."
    }
  ],
