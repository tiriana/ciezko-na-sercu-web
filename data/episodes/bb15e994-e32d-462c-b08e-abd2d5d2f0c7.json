  "quotes": [
    {
      "start": 253.42,
      "text": "Uroki grudniowej nocy opiewał dla państwa zespół Terrestrial Hospice, który rusza w Polskę siać zgorszenie i zniszczenie w towarzystwie grup Pralaja i Upon the Altar."
    },
    {
      "start": 287.34,
      "text": "Nieprzekonanych na pewno przekona Pralaja próbką ich tegorocznej debiutanckiej płyty Beyond the Tattered Curtain of Unspeakable Madness."
    },
    {
      "start": 2115.14,
      "text": "Elende już 2 stycznia wydają swój nowy album zatytułowany Zerfol i opatrzony piękną okładką."
    },
    {
      "start": 3511.93,
      "text": "Na zachętę posłuchamy Time is the Ruler z ich tegorocznego debiutu Opt Out"
    },
    {
      "start": 3591.75,
      "text": "Time is the Ruler."
    },
    {
      "start": 3811.24,
      "text": "koreański artysta Kyuho wpadł, bo to on stoi za Mad Men's Sprite"
    },
    {
      "start": 4250.23,
      "text": "Gwiazda wieczoru będzie grupa Architects, która w tym roku wydała świetny album The Sky, The Earth and All Between"
    },
    {
      "start": 5028.44,
      "text": "Death Worship to plugawy, bezlitosny black death metal z Kanady, obecnie chyba z Niemiec"
    },
    {
      "start": 5387.62,
      "text": "25 stycznia w klubie Kwadrat hipnotyzować mnie będą swoimi dronami i mrokami Amerykanie z Earth"
    },
    {
      "start": 6827.31,
      "text": "tegoroczny album Lorna Shore, czyli znakomity I Feel the Ever Black Festering Within Me"
    }
  ],
