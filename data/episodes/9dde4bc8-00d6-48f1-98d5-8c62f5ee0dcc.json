  "quotes": [
    {
      "start": 801,
      "text": "A puszczę oczywiście Black Sabbath z Heaven and Hell"
    },
    {
      "start": 1152,
      "text": "Eddie Van Halen to był straszny łobuz..."
    },
    {
      "start": 1496,
      "text": "Thin Lizzie, wspaniały zespół..."
    },
    {
      "start": 2196,
      "text": "Nowych płyt Maiden nie słucham w ogóle. Tych z Brucem nagranych do Seven Sun rzadko."
    },
    {
      "start": 3285,
      "text": "Niedawno ukazała się w Polsce książka Born Human, życie i muzyka Chucka Schuldinera"
    },
    {
      "start": 3618,
      "text": "wróciłem do niej latem tego roku, kiedy Mike odszedł..."
    },
    {
      "start": 5003,
      "text": "LG Petrov, wokalista szwedzkiej death metalowej bestii Entombt"
    },
    {
      "start": 6872,
      "text": "Na koniec norweski zespół Mayhem... utwór, który Euronymus z Mayhem zdążył nagrać, z tekstem Deda"
    }
