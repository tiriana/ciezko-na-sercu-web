  "quotes": [
    {
      "start": 300.31,
      "text": "Zabawę zaczną z przytupem, a jakże Australijczycy z Die Alt is Murder"
    },
    {
      "start": 733.31,
      "text": "Primus pojawi się na letniej scenie progresji, by zabrać was w rejs po Morzu Sera"
    },
    {
      "start": 1095.48,
      "text": "zespół Death Heaven"
    },
    {
      "start": 1122.42,
      "text": "Einsturzenten Neubauten"
    },
    {
      "start": 1240.15,
      "text": "Lord of the Lost z piosenką zamykającą ich ostatni album, Opus Noir, Volume 3"
    },
    {
      "start": 2422.43,
      "text": "bo to będzie gwiazda wieczoru z grupą Testament"
    },
    {
      "start": 3059.97,
      "text": "Wystąpią Hermapolis, Pimape i Atom Juice"
    },
    {
      "start": 3368.26,
      "text": "Australijski zespół Rose Tattoo świętuje właśnie pięćdziesięciolecie działalności i zarazem żegna się ze sceną"
    },
    {
      "start": 3499.96,
      "text": "w składzie z nieodżałowanym Peterem Wellsem"
    },
    {
      "start": 4170.42,
      "text": "legenda polskiego black metalu zespół Arkona"
    },
    {
      "start": 4509.64,
      "text": "Przed Wami bardzo stara Arkona"
    },
    {
      "start": 4759.06,
      "text": "Nothing wraca do nas na kolejny w tym roku koncert"
    }
  ],
