  "quotes": [
    {
      "start": 4,
      "text": "Zacząłem dzisiaj od Child in Time, żelaznej klasyki hard rocka, ale w nowej wersji takie Child in Time usłyszeli widzowie najświeższe i podobno już ostatniej serii Stranger Things."
    },
    {
      "start": 5580,
      "text": "więc muzykę stworzył według odpowiednich wytycznych włoski zespół Mokadelik"
    },
    {
      "start": 5864,
      "text": "A jednak Dying Fitus się nie spodziewałem. Sprawdźcie sobie sami sezon 23, odcinek 2"
    },
    {
      "start": 5950,
      "text": "Pojawia się Pleasure to Kill kreatora, doskonały wybór"
    }
