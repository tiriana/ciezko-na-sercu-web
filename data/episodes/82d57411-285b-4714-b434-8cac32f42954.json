  "quotes": [
    {
      "start": 524,
      "text": "Tydzień temu Wolves in the Throne Room nas pożegnali, dzisiaj nas powitali. Piosenka inna, ale zespół ten sam i ten sam najnowszy album amerykańskiej grupy zatytułowany Estuary."
    },
    {
      "start": 685,
      "text": "Glory Hammer to heroiczne fantazy w kosmosie, a więc rycerze w zbrojach walą się po zakutych łbach młotami, ale latają po galaktyce statkami kosmicznymi."
    },
    {
      "start": 1524,
      "text": "Glory Hammer – ... (zapis w kanonadzie)"
    },
    {
      "start": 1625,
      "text": "Hatebreed przyjeżdżają z całkiem nową płytą zatytułowaną Fatal Paradox i żre to pięknie, o czym za chwilę się przekonacie."
    },
    {
      "start": 1745,
      "text": "Posłuchajmy zatem, jak riffami kruszy czaszki Dopplord na ich ostatniej, jak na razie, płycie Songs for Satan."
    },
    {
      "start": 2747,
      "text": "Amerykańska grupa Holy Phone, czyli bardziej rockowo chyba niż metalowo"
    },
    {
      "start": 2847,
      "text": "Posłuchajmy zatem Confess"
    },
    {
      "start": 3123,
      "text": "Nie będzie lepszej okazji, by puścić państwu piosenkę Witchmaster"
    },
    {
      "start": 3805,
      "text": "Korn, a przed nimi wystąpią Architects i Pixel Grip"
    },
    {
      "start": 4534,
      "text": "Imperial Triumphant też dla regularnych słuchaczy ciężko na sercu nowością nie jest"
    },
    {
      "start": 4565,
      "text": "Imperial Triumphant w Krakowie w Hype Parku, a dzień później w stolicy"
    },
    {
      "start": 5495,
      "text": "Belijski zespół Wyatt E, czyli Dumy, Drony i inne dziwadła"
    },
    {
      "start": 6005,
      "text": "Gwiazdą wieczoru natomiast będzie, czy wieczorów właściwie obu, świetny The Ruins of Beverast, łączący black metal z dume'em"
    },
    {
      "start": 6567,
      "text": "Corpsest, Betrayer, Szwedzkie Impurity, In Twilight's Embrace i Repulsive"
    }
  ],
