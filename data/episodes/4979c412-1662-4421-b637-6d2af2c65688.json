  "quotes": [
    {
      "start": 154,
      "text": "Beaver Fever istnieje"
    },
    {
      "start": 1841,
      "text": "Autopsy było niezrównane i mimo deszczu, który rozpadał się już w pierwszych minutach koncertu, tłum pozostał pod sceną"
    },
    {
      "start": 2190,
      "text": "zaprezentowali całą debiutancką płytę Extreme Conditions Demand, Extreme Responses"
    },
    {
      "start": 2220,
      "text": "A że zaprezentowali całą debiutancką płytę Extreme Conditions Demand, Extreme Responses"
    },
    {
      "start": 2530,
      "text": "Brazylijski Ratos de Porao w metalowych kręgach rozsławione przez sepulturę właśnie na tegorocznym Obstin"
    },
    {
      "start": 4040,
      "text": "Hemorage to Hiszpanie, którzy zaczęli chyba jako hołd dla karkas, później odpłynęli nieco w bardziej oryginalnym kierunku"
    },
    {
      "start": 4249,
      "text": "Gutalax, pochodzą z miasteczka Kremrze na południu Czech i grają od jakichś piętnastu lat"
    },
    {
      "start": 5175,
      "text": "Wydany w 1987 roku album Scam to wciąż żywy klasyk i dla wielu najlepsza płyta Napalm Death."
    },
    {
      "start": 5681,
      "text": "The world keeps turning, który był dla nas, fanów z Polski, szczególnie ważny, bo emitowany przez stacje MTV globalnie"
    },
    {
      "start": 5924,
      "text": "Ostatnie płyty Naplom Death, przede wszystkim Apex Predator Easy Meat, to jest rok 2015"
    },
    {
      "start": 5924,
      "text": "oraz Throws of Joy in the Jaws of Defeatism, to jest 2020, to rzeczy znakomite"
    }
  ],
