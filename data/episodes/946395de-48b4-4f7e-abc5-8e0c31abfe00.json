  "quotes": [
    {
      "start": 132,
      "text": "będę grał tylko z płyt koncertowych, a pretekstem do tego jest premiera koncertowej właśnie płyty zespołu Imperator"
    },
    {
      "start": 655,
      "text": "Słuchaliśmy Imperatora z płyty The Time After Time Live, nagranej w 2018 roku w warszawskiej progresji"
    },
    {
      "start": 1314,
      "text": "Na przykład debiut TSA, czyli live, grzecznie na mnie czekał już od 1982 roku"
    },
    {
      "start": 2041,
      "text": "uwielbiałem Turbo i ich płytę Alive poskładaną z dwóch koncertów"
    }
