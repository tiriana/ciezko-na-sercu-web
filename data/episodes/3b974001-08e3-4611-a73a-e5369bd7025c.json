  "quotes": [
    {
      "start": 193.56,
      "text": "March of the Pigs. To oczywiście marsz świn"
    },
    {
      "start": 598.62,
      "text": "grają pieśni protestu bez tekstów"
    },
    {
      "start": 1187.27,
      "text": "Between the Buried and Me ruszyli z tym materiałem w trasę i 9 marca dotrą do nieba tego warszawskiego"
    },
    {
      "start": 1676.15,
      "text": "Alien Weaponry z Nowej Zelandii, a więc maoryski grów Trash"
    },
    {
      "start": 2244.84,
      "text": "Duńczycy z Eyes, Oczy to z kolei lektura obowiązkowa, fantastyczny zespół koncertowy i oryginalne połączenie hardcora z metalem"
    },
    {
      "start": 2364.57,
      "text": "Epica, Amarant i Charlotte Wessels grają na Torwarze"
    },
    {
      "start": 2631.95,
      "text": "Xastur wystąpi 19 marca w Warszawie w klubie Odessa. Gościem będzie szwedzki gitarzysta Lukas Hager"
    },
    {
      "start": 4257.22,
      "text": "Frontside wydają nowy album zatytułowany Nemezis, pierwszy z nowym piosenkarzem Molim"
    },
    {
      "start": 4524.6,
      "text": "Tottenmesse"
    },
    {
      "start": 4584.46,
      "text": "Myrrh, czyli Nasi Ludzie w Norwegii, też black metal najwyższej próby, autorzy świetnego ubiegłorocznego debiutu Hellwagen"
    },
    {
      "start": 5829.6,
      "text": "Hier, którego debiutancki album Monochrome wyszedł właśnie nakładem francuskiej wytwórni Season of Mist"
    },
    {
      "start": 5889.46,
      "text": "Ich nowa płyta, zatytułowana The End Is High, ukazuje się we włoskim labelu Heavy Psych Sounds Records"
    }
  ],
