  "quotes": [
    {
      "start": 179.59,
      "text": "Zacząłem bardzo nietypowo, bo od utworu grupy Beastie Boys"
    },
    {
      "start": 786.19,
      "text": "wysłuchaliśmy właśnie otwarcia podwójnego albumu Eine kleine Nachtmusik, koncertowej płyty Venom z 1986 roku"
    },
    {
      "start": 1167.32,
      "text": "Właśnie koncertowy album Eine Kleine Nachtmusik oraz studyjny Possest, bo ukazały się na licencji"
    },
    {
      "start": 1724.04,
      "text": "Dowiedziałem się stąd na przykład, że Kronos kocha Kate Bush"
    },
    {
      "start": 2357.58,
      "text": "Dopiero na Resurrection, albumie z 2000 roku, Venom pokazał się w pełnej piekielnej krasie"
    },
    {
      "start": 3048.99,
      "text": "Słuchacie Ciężko na sercu w trójce, odcinka, w którym żegnam Kronosa, wokalistę, basistę i frontmana Venom."
    },
    {
      "start": 3570.79,
      "text": "Współpraca Kronosa z black metalowcami to rzecz oczywista, ... bardziej zaskakujące było jego wspólne nagranie z Dave'em Grawlem."
    },
    {
      "start": 3611.7,
      "text": "A zatem Probot. Probot, czyli projekt, w którym Grawl złożył hołd swoim metalowym idolom z ich czynnym udziałem."
    },
    {
      "start": 4258.21,
      "text": "Myślicie, że tytułowa, dwudziestominutowa, blekowo-punkowo-progresywna suita z albumu At War With Satan jest nie do zagrania w radiu?"
    },
    {
      "start": 6086.01,
      "text": "I'm going to do the slowest version of Bloodlust"
    }
  ],
