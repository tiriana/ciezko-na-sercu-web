  "quotes": [
    {
      "start": 1123.42,
      "text": "To był Venom z płyty Black Metal. Piosenka o tym, że nie powinno się palić czarownic."
    },
    {
      "start": 1551.43,
      "text": "To był Celtic Frost, utwór A Dying God Coming into Human Flesh."
    },
    {
      "start": 1582.36,
      "text": "Na przykład album Nightfall, który brzmiał mniej mniej tak."
    },
    {
      "start": 2911.31,
      "text": "piosenkę Cathedral zatytułowaną Utopian Blaster, pochodzącą ze znakomitej płyty The Carnival Bizarre, nagrywał z nimi sam Tony Iommi."
    },
    {
      "start": 3897.04,
      "text": "prezentując nagranie grupy Autopsy... In the Grip of Winter nie brzmi jak głębokie ukłony dla sabatów"
    },
    {
      "start": 5048.4,
      "text": "Wspomniany już debiut płytowy Beherit, czyli The Oath of Black Blood"
    },
    {
      "start": 6845.27,
      "text": "niech będzie Nocturnal Evil"
    }
  ],
