  "quotes": [
    {
      "start": 103.76,
      "text": "Piosenkę na dobry wieczór wykonała dla nas skróda i był to tytułowy utwór z materiału Extreme Speed Violence."
    },
    {
      "start": 228.47,
      "text": "Kolejny zespół, który mam przyjemność Państwu przedstawić, nosi dumną nazwę Odur... tytuł piosenki brzmi La La, La La, La La."
    },
    {
      "start": 420.03,
      "text": "Nazywają się Def Kneel, wydali właśnie epkę o tytule Def Kneel"
    },
    {
      "start": 579.67,
      "text": "trzecia płyta Pure Bedlam nazywa się Jubilance i jest wyciągiem z różnych odmian tak zwanego ciężkiego rocka."
    },
    {
      "start": 893.95,
      "text": "Najnowsza płyta, solowa Roba Bandita, nosi tytuł Rope i wysłuchamy utworu tytułowego."
    },
    {
      "start": 1187.27,
      "text": "Ich nowa epka nosi tytuł Snap i choć słyszyć, że to jeszcze undergroundowa produkcja,"
    },
    {
      "start": 1578.37,
      "text": "Album Monochrom, debiut grupy, ukazał się na świecie z nalepką, zresztą jak najbardziej metalowej wytwórni, czyli Season of Mist."
    },
    {
      "start": 1951.51,
      "text": "Grupa wydała właśnie swoją piątą płytę zatytułowaną Powięź, z której wybrałem dla was utwór Nienasycenie."
    },
    {
      "start": 2536.17,
      "text": "I Belzebong jest jednym z tych zespołów... ich czwarta płyta, The End Is High, ukazuje się za sprawą włoskiej wytwórni Heavy Psych Sounds Records"
    },
    {
      "start": 3351.3,
      "text": "Bydgoska grupa Mortis Day... ukazał się ich piąty album zatytułowany The Bringers of Death"
    },
    {
      "start": 3397.19,
      "text": "album zatytułowany United We Fall... krakowski zespół Thy Disease przedstawił się na nim"
    },
    {
      "start": 3831.19,
      "text": "Budda to duet z Bydgoszczy... zadebiutował właśnie dużym albumem Amiotrophy"
    },
    {
      "start": 4459.75,
      "text": "trzecia płyta Temple of Decay zatytułowana Profanus"
    },
    {
      "start": 4459.75,
      "text": "Album nosi tytuł Insygnia Diabelskiej Władzy"
    },
    {
      "start": 5304.81,
      "text": "puszczę Wam Dominatio in Excelsis"
    },
    {
      "start": 5304.81,
      "text": "To był Upon the Altar"
    }
  ],
